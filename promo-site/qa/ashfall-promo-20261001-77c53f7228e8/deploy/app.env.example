# /etc/ashfall-promo/app.env — owner root:ashfall-promo, mode 0640. Template only: contains NO secrets.
# Every variable read by server/config.mjs is listed. Values shown are the production contract.

# Canonical public origin. Used for Host/Origin checks, redirects and canonical URLs. Must be https.
ASHFALL_PUBLIC_ORIGIN=https://ashfall.teknetik.co
# Bind address and port. The app refuses non-loopback binds unless ASHFALL_ALLOW_NON_LOOPBACK=true (do not set).
ASHFALL_HOST=127.0.0.1
ASHFALL_PORT=3187
# Durable SQLite database (WAL mode, created 0600). systemd StateDirectory owns /var/lib/ashfall-promo.
ASHFALL_DB_PATH=/var/lib/ashfall-promo/community.sqlite
# Optional: built site location (defaults to <release>/dist).
#ASHFALL_DIST_DIR=/srv/ashfall-promo/current/dist

# Client address for abuse limits. Leave EMPTY to use the socket peer address (the default).
# Set ONLY after the Kong route overwrites this header authoritatively with the real socket client IP
# (ops/PREFLIGHT.md "Proxy trust"); the app accepts it only from a loopback peer and only as one valid IP.
ASHFALL_CLIENT_IP_HEADER=

# Account creation. Set an invite code (>= 12 chars, generate it on the host; never commit it) to
# restrict signup to invited testers, or ASHFALL_SIGNUP_ENABLED=false to close signup entirely.
ASHFALL_SIGNUP_ENABLED=true
ASHFALL_SIGNUP_INVITE_CODE=
# Maximum new accounts per client IP per hour.
ASHFALL_SIGNUP_PER_IP_HOUR=10

# Password hashing cost (scrypt N, power of two >= 16384) and session lifetime in days (1..90).
ASHFALL_SCRYPT_N=32768
ASHFALL_SESSION_DAYS=30

# One access-log line per request to the journal (no cookies, bodies or query strings are logged).
ASHFALL_LOG_REQUESTS=true

# TLS is terminated by Kong in production: leave these unset. Only the local QA harness sets them.
#ASHFALL_TLS_CERT=
#ASHFALL_TLS_KEY=
