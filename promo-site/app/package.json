{
  "name": "ashfall-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Ashfall promotional and early-tester community website (self-hosted, Node + SQLite).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 test/unit/*.test.mjs test/integration/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run build && npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "db:migrate": "node server/cli.mjs migrate",
    "db:backup": "node server/cli.mjs backup",
    "manifest": "node scripts/candidate-manifest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
