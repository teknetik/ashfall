# Unity generated state; keep Assets and their .meta files tracked.
unity/**/Library/
unity/**/Temp/
unity/**/Obj/
unity/**/Logs/
unity/**/UserSettings/
unity/**/Builds/
unity/**/*.csproj
unity/**/*.sln
unity/**/Captures/
unity/**/*.slnx
unity/**/.vscode/
unity/evidence/*.log

unity/evidence/**/*.log
unity/AthenHill/mono_crash.*
unity/AthenHill/Assets/_Recovery/
unity/AthenHill/Assets/_Recovery.meta

# Local PulseAudio auth cookies written by isolated QA players
unity/evidence/**/config/pulse/

# Heavy authoring media stays local (review .blend files, renders, walkthrough
# videos, Meshy downloads, reference photos). Only scripts, manifests and notes
# from these folders are versioned; unity/AthenHill is complete for builds.
/art/**/*.*
/meshy/**/*.*
/refs/**/*.*
/unity/evidence/**/*.*
/unity/staging/**/*.glb
!/art/**/*.py
!/art/**/*.md
!/art/**/*.sh
!/art/**/*.txt
!/art/**/*.json
!/meshy/**/*.py
!/meshy/**/*.md
!/meshy/**/*.json
!/meshy/animation-reference/*.txt
!/refs/**/*.md
!/refs/**/*.json
!/refs/**/*.txt
!/unity/evidence/**/*.md
!/unity/evidence/**/*.json
!/unity/evidence/**/*.py
!/unity/evidence/**/*.txt
!/unity/evidence/**/*.xml
