/* World map window (M, 19 Nov 2026; Scripts/Map/WorldMapPanel.cs). The sheet replaces the modal's scroll view:
   a deep enamel viewport with a thin bronze rule (cyan once it has keyboard focus) and a column on the right.
   Labels are warm white on a dark shadow; amber marks Berms sites, cyan the Wardens' waystations and the tracked
   target, bronze city places, as on the compass. Loaded from Resources by the panel and added to the HUD root. */

#modal.map-modal { width: 1680px; max-width: 96%; height: 92%; max-height: 92%; }
#modal.map-modal #modal-subtitle { margin-bottom: 10px; }

.map-panel { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 0; margin-bottom: 8px; }
.map-viewport { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; background-color: #7f6245; border-width: 1px; border-color: #65706a; }
.map-viewport:focus { border-color: #58d5d7; }
.map-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.map-survey-layer { position: absolute; -unity-background-scale-mode: stretch-to-fill; }

.map-label { position: absolute; font-size: 15px; color: #eee9dc; white-space: nowrap; text-shadow: 1px 1px 0 rgba(0,0,0,0.9); -unity-text-align: middle-left; padding: 0; margin: 0; }
.map-label.site { color: #e6b878; }
.map-label.site.cleared { opacity: 0.6; }
.map-label.waystation { color: #8be6df; }
.map-label.gate { color: #eee9dc; letter-spacing: 1px; }
.map-label.shop, .map-label.service { font-size: 13px; color: #d8cfb9; }
.map-label.home { color: #daca9e; }
.map-label.bermsplace { font-size: 14px; color: #bca581; }
.map-label.region { font-size: 24px; letter-spacing: 6px; color: #a48a62; opacity: 0.75; -unity-text-align: middle-center; }

.map-scale { position: absolute; left: 16px; bottom: 14px; flex-direction: column; align-items: flex-start; }
.map-scale-bar { height: 6px; border-width: 1px; border-top-width: 0; border-color: #eee9dc; }
.map-scale-text { font-size: 14px; color: #eee9dc; margin-top: 2px; text-shadow: 1px 1px 0 rgba(0,0,0,0.9); }
.map-north { position: absolute; top: 10px; right: 14px; width: 30px; height: 30px; font-size: 18px; color: #eee9dc; -unity-text-align: middle-center; border-width: 1px; border-color: #a48a62; border-radius: 15px; background-color: rgba(10,14,13,0.7); }
.map-source { position: absolute; right: 14px; bottom: 12px; font-size: 13px; letter-spacing: 2px; color: #bcbcad; text-shadow: 1px 1px 0 rgba(0,0,0,0.9); }

.map-side { width: 340px; flex-shrink: 0; margin-left: 18px; padding-left: 18px; border-left-width: 1px; border-left-color: #2c5a5f; }
.map-heading { color: #a48a62; letter-spacing: 2px; margin: 12px 0 4px; font-size: 14px; }
.map-heading.map-group { margin-top: 8px; }
.map-copy { font-size: 17px; white-space: normal; color: #eee9dc; }
.map-tracked-title { font-size: 17px; color: #8be6df; white-space: normal; letter-spacing: 1px; }
.map-buttons { flex-direction: row; justify-content: space-between; margin-top: 6px; }
.map-button { min-height: 40px; padding: 8px 12px; font-size: 15px; margin: 4px 0; }
.map-buttons .map-button { width: 49%; }
.map-places-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; margin-top: 2px; }
.map-place { min-height: 36px; padding: 6px 12px; margin: 0 0 4px; font-size: 15px; -unity-text-align: middle-left; }
.map-place.site { color: #e6b878; }
.map-place.waystation { color: #8be6df; }

.small-window .map-label { font-size: 18px; }
.small-window .map-copy, .small-window .map-place, .small-window .map-button { font-size: 19px; }
.small-window .map-side { width: 380px; }
