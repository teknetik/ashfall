/* Brann's guided first job (tutor agent, 21 Nov 2026). Round 3 (native sh-real4b: "tiny grey text, unreadable at 1080p"):
   the prompt by the work is a dark plate with the bench legend's bronze edge, two rows with a MOUSE / KEYS chip, warm white
   text and bold control words; the note under the action line carries camera announcements, refusals and H, with no speaker. */
.bench-tutor-prompt { position: absolute; max-width: 460px; background-color: rgba(10,16,15,0.92);
  border-width: 2px; border-color: #c9a46a; border-radius: 4px; padding: 8px 14px 9px 10px; }
.bench-tutor-row { flex-direction: row; align-items: center; margin-top: 3px; }
.bench-tutor-chip { font-size: 13px; color: #10161a; background-color: #e7c88f; -unity-font-style: bold; letter-spacing: 1px;
  padding: 1px 6px; border-radius: 3px; margin-right: 10px; min-width: 58px; -unity-text-align: middle-center; }
.bench-tutor-mouse { font-size: 22px; color: #fff8e8; white-space: normal; flex-shrink: 1; }
.bench-tutor-keys { font-size: 18px; color: #f0dfbd; white-space: normal; flex-shrink: 1; }
.bench-tutor-note { position: absolute; left: 28px; top: 120px; max-width: 700px; font-size: 20px; color: #f6e7c6;
  background-color: rgba(12,20,19,0.82); border-left-width: 3px; border-left-color: #6fc7c1; padding: 4px 12px; white-space: normal; }
.small-window .bench-tutor-prompt { max-width: 400px; }
.small-window .bench-tutor-mouse { font-size: 20px; }
.small-window .bench-tutor-note { font-size: 18px; max-width: 600px; }
