  m_Script: {fileID: 11500000, guid: 5a584a25f7a2f6c23a420ed9d0c79f73, type: 3}
  m_Name: npc_rell
  m_EditorClassIdentifier: AthenHill.Runtime::AthenHill.NpcDefinition
  id: npc_rell
  displayName: Warden Rell
  role: Checkpoint sentry
  nodes:
  - id: greeting
    title: Checkpoint sentry
    text: Rell. I'm watching the return lane. Check in with Ossa at the post down the ramp, collect your pistol from the marked locker under the canopy, then try the range across the lane. Keep this gap clear; it is your way back to Ward.
    voice: {fileID: 8300000, guid: 0ce3ef91ac144836afab16ed110d5a1c, type: 3}
    choices:
    - id: safe
      label: What if the machines chase me?
      next: safe
      action: 
    - id: leave
      label: I'll speak to Ossa.
      next: 
      action: close
  - id: safe
    title: Berms patrol
    text: Don't linger in reach of their clamps. The feral machines signal before they strike. Break contact toward the checkpoint if you need time to recover. Weapons are holstered automatically when you cross back inside Ward.
    voice: {fileID: 8300000, guid: f44afb27b5564201a959b38fad9c8d1b, type: 3}
    choices:
    - id: back
      label: Where do I start?
      next: greeting
      action: 
    - id: leave
      label: Keep the lane clear. Got it.
      next: 
      action: close
