MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce3127b2b0bed0c4789d9872eddff4de, type: 3}
  m_Name: barks_npc_vex
  m_EditorClassIdentifier: AthenHill.Runtime::AthenHill.BarkSet
  speakerId: npc_vex
  displayName: Vex
  lines:
  - id: greet_carts
    trigger: 0
    text: Through you go. Mind the carts.
    voice: {fileID: 8300000, guid: cdb384f15f9bc09779e41c007a5b97d3, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: greet_morning
    trigger: 0
    text: Gate's open. Caravans have the morning.
    voice: {fileID: 8300000, guid: f0ff1b36d912e6f719f63d571c837f58, type: 3}
    requires: 
    hours: {x: 5, y: 11}
    once: 0
    weight: 1
  - id: greet_night
    trigger: 0
    text: Late to be coming through. Stay where I can see you.
    voice: {fileID: 8300000, guid: 7f6e25969804e376892097986021475b, type: 3}
    requires: 
    hours: {x: 21, y: 5}
    once: 0
    weight: 1
  - id: idle_stone
    trigger: 1
    text: Three generations of patches on this stone.
    voice: {fileID: 8300000, guid: 3865ab8b58ac30660a3f61c839517cdf, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: idle_everyone
    trigger: 1
    text: Everyone gets through. Everyone helps hold the gate.
    voice: {fileID: 8300000, guid: 10f3feb4df4004edfa2be6f96e76f9a8, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: weapon
    trigger: 2
    text: Weapons away inside the gate. Wardens' rule, and the Column agrees.
    voice: {fileID: 8300000, guid: 0e8fbec9d4944841ab10ec429e13c76a, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: ack_primer
    trigger: 3
    text: Made it back through the Berms. Plenty don't, first time.
    voice: {fileID: 8300000, guid: 266c20a936bb9fbaf843618c61ec5f39, type: 3}
    requires: primer
    hours: {x: 0, y: 24}
    once: 1
    weight: 1
  - id: ack_home
    trigger: 3
    text: Heard you've got a key now. Near enough one of us.
    voice: {fileID: 8300000, guid: 97ffa5415ec8dad558e3e72900b50695, type: 3}
    requires: flag:home_leased
    hours: {x: 0, y: 24}
    once: 1
    weight: 1
  - id: order_done
    trigger: 4
    text: Saw you come in on Warden business. Good on you.
    voice: {fileID: 8300000, guid: 6ea43a7957dec8fe7988c34de4472911, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
