  m_Script: {fileID: 11500000, guid: ce3127b2b0bed0c4789d9872eddff4de, type: 3}
  m_Name: barks_npc_rell
  m_EditorClassIdentifier: AthenHill.Runtime::AthenHill.BarkSet
  speakerId: npc_rell
  displayName: Warden Rell
  lines:
  - id: greet_lane
    trigger: 0
    text: Return lane's clear. Keep it that way.
    voice: {fileID: 8300000, guid: 5d571080888c95634af819f9fb6cbdeb, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: greet_back
    trigger: 0
    text: Welcome back. Anything following you?
    voice: {fileID: 8300000, guid: 617fe71d782e279a78813a1b851f1ee2, type: 3}
    requires: primer
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: idle_dust
    trigger: 1
    text: Dust on the wind. Could be weather. Could be drones.
    voice: {fileID: 8300000, guid: c63a77db2c122954bbe696657b4b7e63, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: idle_gap
    trigger: 1
    text: Keep the gap clear. It's somebody's way home.
    voice: {fileID: 8300000, guid: 4cd1b8636e6b3c2e3b200cff0b35984f, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: weapon
    trigger: 2
    text: Holster it at the wall. Ward rules.
    voice: {fileID: 8300000, guid: b9c9d2ea20399a4828eb6b31a266a4c6, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: ack_primer
    trigger: 3
    text: You made it through. Plates, drone, depot. Not bad.
    voice: {fileID: 8300000, guid: bdd88b1e5c35aea28866ff3e90a6d84f, type: 3}
    requires: primer
    hours: {x: 0, y: 24}
    once: 1
    weight: 1
  - id: order_done
    trigger: 4
    text: Heard it on the radio. Nice work.
    voice: {fileID: 8300000, guid: 8d5128a98e4f90560a5b12a97016b842, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
