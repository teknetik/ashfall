  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce3127b2b0bed0c4789d9872eddff4de, type: 3}
  m_Name: barks_resident_oren
  m_EditorClassIdentifier: AthenHill.Runtime::AthenHill.BarkSet
  speakerId: resident_oren
  displayName: Oren
  lines:
  - id: pass_ration
    trigger: 5
    text: Two cans a house. Same as in my father's day.
    voice: {fileID: 8300000, guid: 2e78205f6304c1c459c80b41a06d7b49, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: pass_slow
    trigger: 5
    text: Mind the old man. Slow, but he gets there.
    voice: {fileID: 8300000, guid: 9ee6b65728d88dbd8806a9b4778e7b16, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: idle_tap
    trigger: 1
    text: Cold, from the deep rock. Best water on Tir.
    voice: {fileID: 8300000, guid: 5f44afb8621a8d0d6b749574494579c4, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: idle_wall
    trigger: 1
    text: Forty years I've lived on that wall. It's never fallen.
    voice: {fileID: 8300000, guid: f1c63151a0e27d00199ba3d861f6ffb7, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: idle_dust
    trigger: 1
    text: Dust front tonight, mark me. My knees know.
    voice: {fileID: 8300000, guid: e4242199125805fd1a2e108979661f08, type: 3}
    requires: 
    hours: {x: 12, y: 20}
    once: 0
    weight: 1
  - id: weapon
    trigger: 2
    text: Put it away, son. The Wardens are watching.
    voice: {fileID: 8300000, guid: e8ed58f416efe205c8a4828cee7f2061, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
