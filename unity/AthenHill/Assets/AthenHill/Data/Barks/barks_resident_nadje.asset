  m_Script: {fileID: 11500000, guid: ce3127b2b0bed0c4789d9872eddff4de, type: 3}
  m_Name: barks_resident_nadje
  m_EditorClassIdentifier: AthenHill.Runtime::AthenHill.BarkSet
  speakerId: resident_nadje
  displayName: Nadje
  lines:
  - id: pass_caravan
    trigger: 5
    text: Fresh off the caravan. Dates, beans and salt.
    voice: {fileID: 8300000, guid: 5c2f0eb3908d4d3c98dfc9eff4fdd1a2, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: pass_jars
    trigger: 5
    text: Water jars, sealed and tested. Mind your feet.
    voice: {fileID: 8300000, guid: 31677561040f623789d394a69707a6ea, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: idle_berms
    trigger: 1
    text: Every jar on this table crossed the Berms on a beast's back.
    voice: {fileID: 8300000, guid: d7bf44d2e4215f8d0ba961b8008c801a, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
  - id: idle_dust
    trigger: 1
    text: Dust front's coming. I can smell it. Cover the grain.
    voice: {fileID: 8300000, guid: f405d9ba0104a8bdb808474edcc1bd30, type: 3}
    requires: 
    hours: {x: 10, y: 18}
    once: 0
    weight: 1
  - id: idle_lamps
    trigger: 1
    text: Ward keeps its lamps low. Good for prices, bad for eyes.
    voice: {fileID: 8300000, guid: 1db25824159668bc2b8d6bb8db080505, type: 3}
    requires: 
    hours: {x: 18, y: 23}
    once: 0
    weight: 1
  - id: weapon
    trigger: 2
    text: Holster that. Nobody haggles at gunpoint.
    voice: {fileID: 8300000, guid: 94c60230d9830c7408a6444690730599, type: 3}
    requires: 
    hours: {x: 0, y: 24}
    once: 0
    weight: 1
