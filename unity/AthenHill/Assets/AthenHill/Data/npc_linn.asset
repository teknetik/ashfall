  id: npc_linn
  displayName: Linn
  role: Hill regular
  nodes:
  - id: greeting
    title: Hill regular
    text: Looking for someone? Try the shade. Sooner or later everyone comes up here, even the people who swear they are too busy.
    choices:
    - id: tree
      label: Why does everyone meet here?
      next: hill
      action: 
    - id: leave
      label: I will stay for a moment.
      next: 
      action: close
  - id: hill
    title: Hill regular
    text: You can see the gate, hear the market, and get out of the dust. No terminal needs to explain that. If we get separated, meet me on the hill.
    choices:
    - id: back
      label: Who comes up here?
      next: greeting
      action: 
    - id: leave
      label: On the hill. Got it.
      next: 
      action: close
