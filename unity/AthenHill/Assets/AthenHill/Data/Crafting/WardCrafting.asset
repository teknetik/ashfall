%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e12aacedff0e7b41a944668d9e491ef, type: 3}
  m_Name: WardCrafting
  m_EditorClassIdentifier: AthenHill.Runtime::AthenHill.CraftingCatalog
  weapons:
  - id: weapon_scrap_pistol
    name: Scrap Pistol
    stats:
      damage: 34
      fireInterval: 0.28
      range: 70
      recoil: 38
      nanoMax: 100
      nanoPerShot: 9
      nanoRegen: 30
      aimAssist: 3.5
    minStats:
      damage: 1
      fireInterval: 0.08
      range: 10
      recoil: 0
      nanoMax: 20
      nanoPerShot: 1
      nanoRegen: 1
      aimAssist: 0
    maxStats:
      damage: 400
      fireInterval: 2
      range: 200
      recoil: 100
      nanoMax: 400
      nanoPerShot: 60
      nanoRegen: 200
      aimAssist: 12
    slots:
    - grip
    - barrel
    - cell
  modifiers:
  - id: mod_grip_stabilised
    itemId: grip_stabilised_pistol
    slot: grip
    weaponIds:
    - weapon_scrap_pistol
    effects:
    - stat: recoil
      op: add
      value: -7
  - id: mod_barrel_bored_alloy
    itemId: barrel_bored_alloy
    slot: barrel
    weaponIds:
    - weapon_scrap_pistol
    effects:
    - stat: damage
      op: percent
      value: 20
    - stat: range
      op: add
      value: 10
  - id: mod_cell_salvaged_capacitor
    itemId: cell_salvaged_capacitor
    slot: cell
    weaponIds:
    - weapon_scrap_pistol
    effects:
    - stat: nanoMax
      op: add
      value: 35
    - stat: nanoRegen
      op: percent
      value: 15
  - id: mod_grip_gyro_braced
    itemId: grip_gyro_braced
    slot: grip
    weaponIds:
    - weapon_scrap_pistol
    effects:
    - stat: recoil
      op: add
      value: -15
    - stat: aimAssist
      op: add
      value: 1
  - id: mod_barrel_lattice_focused
    itemId: barrel_lattice_focused
    slot: barrel
    weaponIds:
    - weapon_scrap_pistol
    effects:
    - stat: damage
      op: percent
      value: 45
    - stat: range
      op: add
      value: 25
    - stat: fireInterval
      op: percent
      value: 8
  - id: mod_cell_overclocked
    itemId: cell_overclocked
    slot: cell
    weaponIds:
    - weapon_scrap_pistol
    effects:
    - stat: nanoMax
      op: add
      value: 60
    - stat: nanoPerShot
      op: add
      value: -2
    - stat: nanoRegen
      op: percent
      value: 30
  stations:
  - id: station_field_fabricator
    name: Warden Field Fabricator
  recipes:
  - id: recipe_wound_coil
    name: Wound Copper Coil
    stationId: station_field_fabricator
    requiresWeaponId: 
    outputItemId: wound_coil
    inputs:
    - kind: item
      id: copper_filament
      quantity: 2
    - kind: tag
      id: material:conductive
      quantity: 1
    outputQuantity: 1
    knownByDefault: 0
    unlocks:
    - type: orderStart
      id: order_keep_charge
    group: 0
    lockedHint: Ossa issues this schematic with her Keep the Charge order.
  - id: recipe_charge_cell_core
    name: Charge Cell Core
    stationId: station_field_fabricator
    requiresWeaponId: 
    outputItemId: charge_cell_core
    inputs:
    - kind: tag
      id: component:capacitor
      quantity: 2
    - kind: item
      id: wound_coil
      quantity: 1
    - kind: tag
      id: nanite:tier1
      quantity: 3
    outputQuantity: 1
    knownByDefault: 0
    unlocks:
    - type: orderStart
      id: order_keep_charge
    - type: acquireItem
      id: micro_capacitor
    group: 0
    lockedHint: Recover a micro capacitor from a scrap drone to learn this.
  - id: recipe_alloy_plate
    name: Refined Alloy Plate
    stationId: station_field_fabricator
    requiresWeaponId: 
    outputItemId: alloy_plate
    inputs:
    - kind: item
      id: scrap_alloy
      quantity: 3
    - kind: tag
      id: nanite:tier1
      quantity: 2
    outputQuantity: 1
    knownByDefault: 0
    unlocks:
    - type: orderStart
      id: order_bore_true
    group: 0
    lockedHint: Ossa issues this schematic with her Bore It True order.
  - id: recipe_grip_stabilised_pistol
    name: Stabilised Pistol Grip
    stationId: station_field_fabricator
    requiresWeaponId: weapon_scrap_pistol
    outputItemId: grip_stabilised_pistol
    inputs:
    - kind: tag
      id: component:servo
      quantity: 1
    - kind: item
      id: scrap_alloy
      quantity: 2
    - kind: tag
      id: nanite:tier1
      quantity: 5
    outputQuantity: 1
    knownByDefault: 0
    unlocks:
    - type: acquireItem
      id: droid_servo_damaged
    group: 1
    lockedHint: Salvage a worker-droid servo at the machine depot to learn this.
  - id: recipe_cell_salvaged_capacitor
    name: Salvaged Capacitor Cell
    stationId: station_field_fabricator
    requiresWeaponId: weapon_scrap_pistol
    outputItemId: cell_salvaged_capacitor
    inputs:
    - kind: item
      id: charge_cell_core
      quantity: 1
    - kind: item
      id: scrap_alloy
      quantity: 2
    outputQuantity: 1
    knownByDefault: 0
    unlocks:
    - type: orderStart
      id: order_keep_charge
    group: 1
    lockedHint: Ossa issues this schematic with her Keep the Charge order.
  - id: recipe_barrel_bored_alloy
    name: Bored Alloy Barrel
    stationId: station_field_fabricator
    requiresWeaponId: weapon_scrap_pistol
    outputItemId: barrel_bored_alloy
    inputs:
    - kind: item
      id: alloy_plate
      quantity: 2
    - kind: item
      id: wound_coil
      quantity: 1
    outputQuantity: 1
    knownByDefault: 0
    unlocks:
    - type: orderStart
      id: order_bore_true
    group: 1
    lockedHint: Ossa issues this schematic with her Bore It True order.
  - id: recipe_grip_gyro_braced
    name: Gyro-Braced Grip
    stationId: station_field_fabricator
    requiresWeaponId: weapon_scrap_pistol
    outputItemId: grip_gyro_braced
    inputs:
    - kind: item
      id: actuator_intact
      quantity: 1
    - kind: item
      id: alloy_plate
      quantity: 2
    outputQuantity: 1
    knownByDefault: 0
    unlocks:
    - type: acquireItem
      id: foreman_control_core
    group: 2
    lockedHint: Ossa thinks the depot foreman's control core still holds Mark II schematics.
  - id: recipe_barrel_lattice_focused
    name: Lattice-Focused Barrel
    stationId: station_field_fabricator
    requiresWeaponId: weapon_scrap_pistol
    outputItemId: barrel_lattice_focused
    inputs:
    - kind: item
      id: lattice_shard
      quantity: 1
    - kind: item
      id: alloy_plate
      quantity: 2
    - kind: item
      id: wound_coil
      quantity: 2
    - kind: tag
      id: component:optic
      quantity: 1
    outputQuantity: 1
    knownByDefault: 0
    unlocks:
    - type: acquireItem
      id: foreman_control_core
    group: 2
    lockedHint: Ossa thinks the depot foreman's control core still holds Mark II schematics.
  - id: recipe_cell_overclocked
    name: Overclocked Charge Cell
    stationId: station_field_fabricator
    requiresWeaponId: weapon_scrap_pistol
    outputItemId: cell_overclocked
    inputs:
    - kind: item
      id: charge_cell_core
      quantity: 2
    - kind: item
      id: lattice_shard
      quantity: 1
    outputQuantity: 1
    knownByDefault: 0
    unlocks:
    - type: acquireItem
      id: foreman_control_core
    group: 2
    lockedHint: Ossa thinks the depot foreman's control core still holds Mark II schematics.
