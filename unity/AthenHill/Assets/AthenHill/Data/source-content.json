        {
          "id": "greeting",
          "speaker": "Mira",
          "title": "Basic General",
          "text": "Welcome to Basic General. Fresh seals on the flasks, checked packs in the medkits. I can buy that scrap coil if you need a few credits.",
          "choices": [
            {
              "id": "browse",
              "label": "Show me your stock.",
