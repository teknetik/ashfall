  m_Script: {fileID: 11500000, guid: 5a584a25f7a2f6c23a420ed9d0c79f73, type: 3}
  m_Name: npc_torr
  m_EditorClassIdentifier: Assembly-CSharp::AthenHill.NpcDefinition
  id: npc_torr
  displayName: Torr
  role: Local fixer
  nodes:
  - id: greeting
    title: Local fixer
    text: The city looks quiet from the hill. Down here, every cracked terminal has someone waiting on a spare part.
    choices:
    - id: terminals
      label: What is this slab used for?
      next: slab
      action: 
    - id: leave
      label: I will leave you to it.
      next: 
      action: close
  - id: slab
    title: Local fixer
    text: It used to match shifts with maintenance crews. Today we leave notes for each other. Ask around the hill before you trust a blank screen.
    choices:
    - id: back
      label: About the city...
      next: greeting
      action: 
    - id: leave
      label: I will remember that.
      next: 
      action: close
