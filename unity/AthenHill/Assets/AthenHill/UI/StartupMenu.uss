/* Ward arrival artwork is menu art; typography and controls remain native UI. */
#startup-instance, #startup-screen, #startup-content, #startup-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
#startup-screen { display: none; background-color: #101b1e; }
#startup-backdrop { background-image: url("MenuArt/WardArrival-v1.png"); -unity-background-scale-mode: scale-and-crop; }
.arrival-header { position: absolute; top: 6%; left: 7%; flex-direction: row; align-items: center; }
.arrival-beacon { width: 8px; height: 8px; background-color: #73d8d1; rotate: 45deg; margin-right: 15px; }
.arrival-location { font-size: 18px; letter-spacing: 5px; color: #d0d6cb; }
.arrival-copy { position: absolute; top: 23%; left: 7%; width: 410px; }
.arrival-eyebrow { font-size: 18px; letter-spacing: 6px; color: #c6ae80; margin-bottom: 22px; }
.arrival-title { font-size: 112px; letter-spacing: 12px; -unity-font-style: bold; color: #f1e8d4; height: 117px; -unity-text-outline-width: 0.3px; -unity-text-outline-color: #f1e8d4; }
.arrival-title-last { letter-spacing: 20px; }
.arrival-rule { width: 64px; height: 2px; background-color: #c5a675; margin-top: 24px; margin-bottom: 20px; }
.arrival-description { font-size: 24px; color: #c8cfbf; }
#startup-actions { margin-top: 49px; width: 360px; }
.arrival-button { flex-direction: row; align-items: center; justify-content: space-between; min-height: 64px; padding: 14px 25px; margin: 0 0 12px; background-image: url("Art/button.png"); -unity-slice-scale: 1px; background-color: rgba(12,25,26,0.64); }
.arrival-button-label { font-size: 24px; letter-spacing: 1px; }
.arrival-primary { border-left-width: 3px; border-left-color: #c8b283; }
.arrival-arrow { font-size: 36px; color: #c9b283; }
.arrival-settings-mark { font-size: 24px; color: #a8b5a9; }
.arrival-button:hover, .arrival-button:focus { background-image: url("Art/button-focus.png"); background-color: rgba(34,66,66,0.85); -unity-background-image-tint-color: #d5eece; }
.arrival-button:focus { border-left-color: #71ded5; }
.arrival-button:active { background-color: #142b2b; -unity-background-image-tint-color: #839990; }
.arrival-footer { position: absolute; bottom: 5%; left: 7%; right: 7%; }
.arrival-help { font-size: 17px; color: #b9c2b5; margin-bottom: 18px; }
.arrival-footer-rule { height: 1px; background-color: rgba(184,170,138,0.35); margin-bottom: 15px; }
.arrival-build { font-size: 14px; letter-spacing: 4px; color: #c3baa4; }
.small-window .arrival-copy { top: 18%; }
.small-window .arrival-title { font-size: 98px; height: 102px; }
.small-window .arrival-eyebrow { margin-bottom: 12px; }
.small-window #startup-actions { margin-top: 28px; }
.small-window .arrival-help { font-size: 20px; }
.startup-settings #shade { background-color: rgba(5,11,12,0.54); }
