/* Six full-resolution 512 px cells on one transparent 1536 x 1024 source atlas.
   Square icon boxes keep the 3 x 2 sampling exact; no cropped derivative textures. */
.equipment-helmet-icon,
.equipment-vest-icon,
.equipment-gloves-icon,
.equipment-legs-icon,
.equipment-boots-icon,
.equipment-neural-icon {
 background-image: url("EquipmentIcons.png");
 background-size: 300% 200%;
 background-repeat: no-repeat no-repeat;
 -unity-background-image-tint-color: white;
}
.equipment-helmet-icon { background-position: left top; }
.equipment-vest-icon { background-position: center top; }
.equipment-gloves-icon { background-position: right top; }
.equipment-legs-icon { background-position: left bottom; }
.equipment-boots-icon { background-position: center bottom; }
.equipment-neural-icon { background-position: right bottom; }

.details-icon.equipment-helmet-icon,
.details-icon.equipment-vest-icon,
.details-icon.equipment-gloves-icon,
.details-icon.equipment-legs-icon,
.details-icon.equipment-boots-icon,
.details-icon.equipment-neural-icon { width: 150px; height: 150px; }

.equipment-inspector-icon.equipment-helmet-icon,
.equipment-inspector-icon.equipment-vest-icon,
.equipment-inspector-icon.equipment-gloves-icon,
.equipment-inspector-icon.equipment-legs-icon,
.equipment-inspector-icon.equipment-boots-icon,
.equipment-inspector-icon.equipment-neural-icon { width: 112px; height: 112px; }

.merchant-art.equipment-helmet-icon,
.merchant-art.equipment-vest-icon,
.merchant-art.equipment-gloves-icon,
.merchant-art.equipment-legs-icon,
.merchant-art.equipment-boots-icon,
.merchant-art.equipment-neural-icon { width: 144px; height: 144px; align-self: center; }

.small-window .merchant-art.equipment-helmet-icon,
.small-window .merchant-art.equipment-vest-icon,
.small-window .merchant-art.equipment-gloves-icon,
.small-window .merchant-art.equipment-legs-icon,
.small-window .merchant-art.equipment-boots-icon,
.small-window .merchant-art.equipment-neural-icon { width: 114px; height: 114px; }

.anatomy-slot .character-slot-icon.equipment-helmet-icon,
.anatomy-slot .character-slot-icon.equipment-vest-icon,
.anatomy-slot .character-slot-icon.equipment-gloves-icon,
.anatomy-slot .character-slot-icon.equipment-legs-icon,
.anatomy-slot .character-slot-icon.equipment-boots-icon,
.anatomy-slot .character-slot-icon.equipment-neural-icon { width: 23px; height: 23px; }
