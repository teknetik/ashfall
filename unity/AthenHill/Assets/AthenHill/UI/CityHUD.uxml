<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
 <!-- THESIS: A worn colony field interface frames the city. OWN-WORLD: bronze rails, inset charcoal enamel, ivory lettering and cyan indicators. STORY: locate, meet, trade and connect. FIRST VIEWPORT: identity upper-left, heading centered, notes upper-right; log and illustrated equipment below, open world between. FORM: user-supplied reference composition, 8 September 2026; shared chrome across every menu. -->
 <Style src="CityHUD.uss" />
 <Style src="MerchantPanel.uss" />
 <Style src="EquipmentIcons.uss" />
 <ui:Template name="StartupMenu" src="StartupMenu.uxml" />
 <ui:VisualElement usage-hints="DynamicColor" name="hud" picking-mode="Ignore">
  <ui:VisualElement usage-hints="DynamicColor" name="identity" class="panel" picking-mode="Ignore">
   <ui:VisualElement usage-hints="DynamicColor" class="identity-heading" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" class="insignia" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" picking-mode="Ignore"><ui:Label usage-hints="DynamicColor" text="COLONIST" class="identity-title"/><ui:Label usage-hints="DynamicColor" text="FREE COLUMN" class="muted identity-faction"/></ui:VisualElement></ui:VisualElement>
   <ui:VisualElement usage-hints="DynamicColor" name="vitals" picking-mode="Ignore">
    <ui:VisualElement usage-hints="DynamicColor" class="vital-row" picking-mode="Ignore"><ui:Label usage-hints="DynamicColor" text="VITALITY" class="vital-label"/><ui:VisualElement usage-hints="DynamicColor" class="meter" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" class="vital-bar" picking-mode="Ignore"/></ui:VisualElement><ui:Label usage-hints="DynamicColor" text="100 / 100" class="vital-value"/></ui:VisualElement>
    <ui:VisualElement usage-hints="DynamicColor" class="vital-row" picking-mode="Ignore"><ui:Label usage-hints="DynamicColor" text="NANO" class="vital-label"/><ui:VisualElement usage-hints="DynamicColor" class="meter" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" class="nano-bar" picking-mode="Ignore"/></ui:VisualElement><ui:Label usage-hints="DynamicColor" text="100 / 100" class="vital-value"/></ui:VisualElement>
   </ui:VisualElement>
   <ui:Label usage-hints="DynamicColor" text="ATHEN HILL" class="district-title"/><ui:Label usage-hints="DynamicColor" text="Colony district" class="muted district-subtitle"/>
  </ui:VisualElement>
  <ui:VisualElement usage-hints="DynamicColor" name="compass" class="panel" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" name="compass-track" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" class="compass-pointer diamond" picking-mode="Ignore"/></ui:VisualElement>
  <ui:VisualElement usage-hints="DynamicColor" name="objective-box" class="panel" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" class="section-heading" picking-mode="Ignore"><ui:Label usage-hints="DynamicColor" text="FIELD NOTES" class="small"/><ui:VisualElement usage-hints="DynamicColor" class="signal" picking-mode="Ignore"/></ui:VisualElement><ui:Label usage-hints="DynamicColor" name="objective"/><ui:VisualElement usage-hints="DynamicColor" class="objective-progress" picking-mode="Ignore"><ui:Label usage-hints="DynamicColor" name="progress" class="muted small"/><ui:VisualElement usage-hints="DynamicColor" name="progress-marks" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" name="mark0" class="progress-mark" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" name="mark1" class="progress-mark" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" name="mark2" class="progress-mark" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" name="mark3" class="progress-mark" picking-mode="Ignore"/></ui:VisualElement></ui:VisualElement></ui:VisualElement>
  <ui:VisualElement usage-hints="DynamicColor" name="top-actions" class="panel"><ui:Button usage-hints="DynamicColor" name="inventory-button" class="utility" tooltip="Open field pack · 5"><ui:VisualElement usage-hints="DynamicColor" class="mini-icon inventory-icon" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="Inventory" picking-mode="Ignore"/></ui:Button><ui:VisualElement usage-hints="DynamicColor" class="credit-readout" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" class="mini-icon coins-icon" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" name="credits" text="25 cr"/></ui:VisualElement><ui:Button usage-hints="DynamicColor" name="notes-button" class="utility" tooltip="Open city notes · 6"><ui:VisualElement usage-hints="DynamicColor" class="mini-icon journal-icon" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="Notes" picking-mode="Ignore"/></ui:Button><ui:Button usage-hints="DynamicColor" name="pause-button" class="utility" tooltip="Pause · Esc"><ui:VisualElement usage-hints="DynamicColor" class="mini-icon gear-icon" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="Pause" picking-mode="Ignore"/></ui:Button></ui:VisualElement>
  <ui:Label usage-hints="DynamicColor" name="notice" class="panel" picking-mode="Ignore"/>
  <ui:VisualElement usage-hints="DynamicColor" name="radio" class="panel" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" class="radio-heading" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" class="radio-signal" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" name="radio-speaker" class="small radio-speaker" picking-mode="Ignore"/></ui:VisualElement><ui:Label usage-hints="DynamicColor" name="radio-text" class="radio-text" picking-mode="Ignore"/></ui:VisualElement>
  <ui:VisualElement usage-hints="DynamicColor" name="nametags" picking-mode="Ignore"/>
  <ui:Button usage-hints="DynamicColor" name="interaction" text="E · Talk"/>
  <ui:VisualElement usage-hints="DynamicColor" name="chat" class="panel"><ui:VisualElement usage-hints="DynamicColor" name="chat-heading" class="section-heading" picking-mode="Ignore"><ui:Label usage-hints="DynamicColor" text="LOCAL" class="channel-title"/><ui:Label usage-hints="DynamicColor" text="EVENT LOG" class="small muted"/></ui:VisualElement><ui:ScrollView name="log-scroll" horizontal-scroller-visibility="Hidden"><ui:Label usage-hints="DynamicColor" name="log"/></ui:ScrollView><ui:VisualElement usage-hints="DynamicColor" name="chat-footer" class="chat-footer" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" class="mini-icon talk-icon" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="Local transmissions" class="muted small"/></ui:VisualElement></ui:VisualElement>
  <ui:VisualElement usage-hints="DynamicColor" name="quickbar" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" name="hotbar" class="panel">
   <ui:Button usage-hints="DynamicColor" name="slot1" class="hotbar-slot selected" tooltip="Inspect water flask · 1"><ui:Label usage-hints="DynamicColor" text="1" class="keycap" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" class="item-art flask-icon" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="Flask" class="slot-label" picking-mode="Ignore"/></ui:Button>
   <ui:Button usage-hints="DynamicColor" name="slot2" class="hotbar-slot" tooltip="Inspect medkit · 2"><ui:Label usage-hints="DynamicColor" text="2" class="keycap" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" class="item-art medkit-icon" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="Medkit" class="slot-label" picking-mode="Ignore"/></ui:Button>
   <ui:Button usage-hints="DynamicColor" name="slot3" class="hotbar-slot" tooltip="Lattice Jack · 3"><ui:Label usage-hints="DynamicColor" text="3" class="keycap" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" class="item-art lattice-icon" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="Lattice" class="slot-label" picking-mode="Ignore"/></ui:Button>
   <ui:Button usage-hints="DynamicColor" name="slot4" class="hotbar-slot" tooltip="Talk to a nearby colonist · 4"><ui:Label usage-hints="DynamicColor" text="4" class="keycap" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" class="item-art talk-icon" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="Talk" class="slot-label" picking-mode="Ignore"/></ui:Button>
   <ui:Button usage-hints="DynamicColor" name="slot5" class="hotbar-slot" tooltip="Open field pack · 5"><ui:Label usage-hints="DynamicColor" text="5" class="keycap" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" class="item-art pack-icon" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="Pack" class="slot-label" picking-mode="Ignore"/></ui:Button>
   <ui:Button usage-hints="DynamicColor" name="slot6" class="hotbar-slot" tooltip="Open city notes · 6"><ui:Label usage-hints="DynamicColor" text="6" class="keycap" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" class="item-art notes-icon" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="Notes" class="slot-label" picking-mode="Ignore"/></ui:Button>
   <ui:Button usage-hints="DynamicColor" name="slot7" class="hotbar-slot empty-slot" tooltip="Empty slot · 7"><ui:Label usage-hints="DynamicColor" text="7" class="keycap" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="–" class="empty-slot-marker" picking-mode="Ignore"/></ui:Button>
   <ui:Button usage-hints="DynamicColor" name="slot8" class="hotbar-slot empty-slot" tooltip="Empty slot · 8"><ui:Label usage-hints="DynamicColor" text="8" class="keycap" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="–" class="empty-slot-marker" picking-mode="Ignore"/></ui:Button>
   <ui:Button usage-hints="DynamicColor" name="slot9" class="hotbar-slot empty-slot" tooltip="Empty slot · 9"><ui:Label usage-hints="DynamicColor" text="9" class="keycap" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="–" class="empty-slot-marker" picking-mode="Ignore"/></ui:Button>
   <ui:Button usage-hints="DynamicColor" name="slot10" class="hotbar-slot empty-slot" tooltip="Empty slot · 0"><ui:Label usage-hints="DynamicColor" text="0" class="keycap" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="–" class="empty-slot-marker" picking-mode="Ignore"/></ui:Button>
  </ui:VisualElement></ui:VisualElement>
  <ui:VisualElement usage-hints="DynamicColor" name="key-hints" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" class="hint panel" picking-mode="Ignore"><ui:Label usage-hints="DynamicColor" text="E" class="hint-key"/><ui:Label usage-hints="DynamicColor" text="Interact"/></ui:VisualElement><ui:Button usage-hints="DynamicColor" name="hint-pause" class="hint"><ui:Label usage-hints="DynamicColor" text="Esc" class="hint-key" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" text="Pause" picking-mode="Ignore"/></ui:Button></ui:VisualElement>
 </ui:VisualElement>
 <ui:Instance template="StartupMenu" name="startup-instance" picking-mode="Ignore" />
 <ui:VisualElement usage-hints="DynamicColor" name="shade">
  <ui:VisualElement usage-hints="DynamicColor" name="modal" class="panel">
   <ui:VisualElement usage-hints="DynamicColor" class="modal-heading"><ui:VisualElement usage-hints="DynamicColor" class="modal-emblem diamond" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" name="modal-title" class="title"/><ui:Button usage-hints="DynamicColor" name="close" text="Clear"/></ui:VisualElement>
   <ui:Label usage-hints="DynamicColor" name="modal-subtitle" class="muted"/>
   <ui:VisualElement name="settings-panel"/>
   <ui:ScrollView name="modal-scroll" horizontal-scroller-visibility="Hidden">
    <ui:VisualElement usage-hints="DynamicColor" name="dialogue-panel"><ui:Label usage-hints="DynamicColor" name="dialogue-text" class="body-copy"/><ui:Label usage-hints="DynamicColor" text="YOUR RESPONSE" class="small muted response-heading"/><ui:Button usage-hints="DynamicColor" name="choice0"/><ui:Button usage-hints="DynamicColor" name="choice1"/><ui:Button usage-hints="DynamicColor" name="choice2"/></ui:VisualElement>
    <ui:VisualElement usage-hints="DynamicColor" name="shop-panel"/>
    <ui:VisualElement usage-hints="DynamicColor" name="fabricator-panel">
     <ui:VisualElement usage-hints="DynamicColor" name="fab-columns" class="fab-columns">
      <ui:VisualElement usage-hints="DynamicColor" name="fab-recipes" class="fab-col fab-col-list">
       <ui:Label usage-hints="DynamicColor" text="SCHEMATICS" class="small fab-heading"/>
       <ui:VisualElement usage-hints="DynamicColor" name="fab-recipe-list"/>
      </ui:VisualElement>
      <ui:VisualElement usage-hints="DynamicColor" name="fab-detail" class="fab-col fab-col-detail">
       <ui:Label usage-hints="DynamicColor" name="fabricator-recipe" class="fab-title"/>
       <ui:Label usage-hints="DynamicColor" name="fab-description" class="muted fab-description"/>
       <ui:Label usage-hints="DynamicColor" text="PARTS · CARRIED / NEEDED" class="small fab-heading"/>
       <ui:VisualElement usage-hints="DynamicColor" name="fabricator-ingredients" class="fab-inputs"/>
       <ui:VisualElement usage-hints="DynamicColor" class="fab-actions">
        <ui:Button usage-hints="DynamicColor" name="fabricator-craft" text="Fabricate"/>
        <ui:Button usage-hints="DynamicColor" name="fabricator-fit" text="Fit to pistol"/>
        <ui:Button usage-hints="DynamicColor" name="fabricator-remove" text="Remove"/>
       </ui:VisualElement>
       <ui:Label usage-hints="DynamicColor" name="fab-reason" class="fab-reason"/>
      </ui:VisualElement>
      <ui:VisualElement usage-hints="DynamicColor" name="fab-pistol" class="fab-col fab-col-pistol">
       <ui:Label usage-hints="DynamicColor" name="fabricator-stat" text="SCRAP PISTOL" class="small fab-heading"/>
       <ui:VisualElement usage-hints="DynamicColor" name="fab-slots"/>
       <ui:Label usage-hints="DynamicColor" text="STATS" class="small fab-heading fab-stats-heading"/>
       <ui:VisualElement usage-hints="DynamicColor" name="fab-stats"/>
      </ui:VisualElement>
     </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement usage-hints="DynamicColor" name="inventory-panel">
     <!-- Ashfall pack, 2 Oct 2026: compact grid | item inspector | anatomical loadout | appropriate live preview. -->
     <ui:VisualElement usage-hints="DynamicColor" name="inventory-content" class="inventory-content">
      <ui:VisualElement usage-hints="DynamicColor" name="pack-col" class="pack-col tech-panel">
       <ui:VisualElement usage-hints="DynamicColor" class="pack-tabs">
        <ui:Button usage-hints="DynamicColor" name="pack-tab-items" text="PACK" class="pack-tab active-tab" tooltip="Carried supplies, salvage, parts and mods"/>
        <ui:Button usage-hints="DynamicColor" name="pack-tab-schematics" text="SCHEMATICS" class="pack-tab" tooltip="Known field-fabricator schematics and the parts they need"/>
        <ui:VisualElement usage-hints="DynamicColor" class="pack-credit-readout" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" class="mini-icon coins-icon" picking-mode="Ignore"/><ui:Label usage-hints="DynamicColor" name="pack-credit" class="pack-credit" picking-mode="Ignore"/></ui:VisualElement>
       </ui:VisualElement>
       <ui:VisualElement name="pack-capacity" class="pack-capacity" picking-mode="Ignore"/>
       <ui:VisualElement usage-hints="DynamicColor" class="pack-tools">
        <ui:VisualElement usage-hints="DynamicColor" class="pack-search-box"><ui:VisualElement usage-hints="DynamicColor" class="pack-search-glyph" picking-mode="Ignore"/><ui:TextField name="pack-search" class="pack-search" max-length="32"/><ui:Label usage-hints="DynamicColor" name="pack-search-placeholder" text="Search" class="pack-search-placeholder" picking-mode="Ignore"/></ui:VisualElement>
        <ui:VisualElement usage-hints="DynamicColor" name="pack-filters" class="pack-filters"/>
       </ui:VisualElement>
       <ui:ScrollView name="inventory-scroll" class="inventory-scroll" horizontal-scroller-visibility="Hidden">
        <ui:VisualElement usage-hints="DynamicColor" name="inventory-grid" class="inventory-grid" />
        <ui:VisualElement usage-hints="DynamicColor" name="inventory-empty" class="inventory-empty" picking-mode="Ignore">
         <ui:Label usage-hints="DynamicColor" name="inventory-empty-title" class="body-copy" text="Your field pack is empty." />
         <ui:Label usage-hints="DynamicColor" name="inventory-empty-subtitle" class="muted" text="Supplies you acquire will appear here." />
        </ui:VisualElement>
       </ui:ScrollView>
       <ui:VisualElement usage-hints="DynamicColor" name="inventory-overview" class="inventory-overview" picking-mode="Ignore">
        <ui:VisualElement usage-hints="DynamicColor" class="inventory-overview-frame" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" name="inventory-overview-icon" class="inventory-overview-icon" picking-mode="Ignore" /></ui:VisualElement>
        <ui:VisualElement usage-hints="DynamicColor" class="inventory-overview-copy" picking-mode="Ignore">
         <ui:Label usage-hints="DynamicColor" name="inventory-overview-name" class="inventory-overview-name" text="No item selected." />
         <ui:Label usage-hints="DynamicColor" name="inventory-overview-quantity" class="muted inventory-overview-quantity" text="" />
         <ui:Label usage-hints="DynamicColor" name="inventory-overview-description" class="inventory-overview-description" text="" />
        </ui:VisualElement>
       </ui:VisualElement>
       <ui:VisualElement usage-hints="DynamicColor" class="pack-footer" picking-mode="Ignore"><ui:Label usage-hints="DynamicColor" name="pack-filter-name" class="pack-filter-name" text="ALL ITEMS"/><ui:Label usage-hints="DynamicColor" name="pack-summary" class="muted pack-summary"/></ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement usage-hints="DynamicColor" name="inventory-details" class="inventory-details tech-panel">
       <ui:VisualElement usage-hints="DynamicColor" class="modal-heading details-heading">
        <ui:VisualElement usage-hints="DynamicColor" class="modal-emblem diamond" picking-mode="Ignore" />
        <ui:Label usage-hints="DynamicColor" name="details-title" class="title" text="Item details" />
        <ui:Button usage-hints="DynamicColor" name="details-close" text="Clear" />
       </ui:VisualElement>
       <ui:VisualElement usage-hints="DynamicColor" class="details-body">
        <ui:VisualElement usage-hints="DynamicColor" class="details-icon-frame" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" name="details-icon" class="details-icon" picking-mode="Ignore" /></ui:VisualElement>
        <ui:Label usage-hints="DynamicColor" name="details-quantity" class="muted" text="" />
        <ui:Label usage-hints="DynamicColor" name="details-prices" class="muted small" text="" />
        <ui:ScrollView name="details-scroll" horizontal-scroller-visibility="Hidden">
         <ui:Label usage-hints="DynamicColor" name="details-description" class="body-copy" text="" />
        </ui:ScrollView>
       </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement usage-hints="DynamicColor" name="you-col" class="you-col tech-panel" picking-mode="Ignore">
       <ui:VisualElement usage-hints="DynamicColor" class="pack-tabs" picking-mode="Ignore"><ui:Label usage-hints="DynamicColor" text="LOADOUT" class="pack-tab-label active-tab"/></ui:VisualElement>
       <ui:VisualElement name="character-loadout" class="character-loadout"/>
       <ui:VisualElement usage-hints="DynamicColor" class="loadout" picking-mode="Ignore">
        <ui:VisualElement usage-hints="DynamicColor" name="loadout-left" class="loadout-slots" picking-mode="Ignore"/>
        <ui:VisualElement usage-hints="DynamicColor" class="colonist-card" picking-mode="Ignore">
         <ui:Label usage-hints="DynamicColor" name="colonist-name" text="Colonist" class="colonist-name"/>
         <ui:Label usage-hints="DynamicColor" name="colonist-faction" text="FREE COLUMN" class="colonist-faction"/>
         <ui:VisualElement usage-hints="DynamicColor" name="colonist-facts" class="colonist-facts" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:VisualElement usage-hints="DynamicColor" name="loadout-right" class="loadout-slots" picking-mode="Ignore"/>
       </ui:VisualElement>
       <ui:VisualElement usage-hints="DynamicColor" class="you-progress" picking-mode="Ignore">
        <ui:VisualElement usage-hints="DynamicColor" class="you-progress-row" picking-mode="Ignore"><ui:Label usage-hints="DynamicColor" name="you-progress-label" class="you-progress-label"/><ui:Label usage-hints="DynamicColor" name="you-progress-value" class="you-progress-value"/></ui:VisualElement>
        <ui:VisualElement usage-hints="DynamicColor" class="you-progress-track" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" name="you-progress-fill" class="you-progress-fill" picking-mode="Ignore"/></ui:VisualElement>
       </ui:VisualElement>
       <ui:VisualElement usage-hints="DynamicColor" name="you-stats" class="you-stats" picking-mode="Ignore"/>
      </ui:VisualElement>
      <ui:VisualElement usage-hints="DynamicColor" name="preview-col" class="preview-col tech-panel">
       <ui:VisualElement usage-hints="DynamicColor" name="preview-fallback" class="preview-fallback insignia" picking-mode="Ignore"/>
       <ui:VisualElement usage-hints="DynamicColor" name="preview-view" class="preview-view" tooltip="Drag to turn · double-click to face"/>
       <ui:VisualElement usage-hints="DynamicColor" class="preview-corner tl" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" class="preview-corner tr" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" class="preview-corner bl" picking-mode="Ignore"/><ui:VisualElement usage-hints="DynamicColor" class="preview-corner br" picking-mode="Ignore"/>
       <ui:VisualElement usage-hints="DynamicColor" class="preview-caption" picking-mode="Ignore"><ui:Label usage-hints="DynamicColor" name="preview-name" text="COLONIST" class="preview-name"/><ui:Label usage-hints="DynamicColor" name="preview-hint" text="Drag to turn" class="muted preview-hint"/></ui:VisualElement>
      </ui:VisualElement>
     </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement usage-hints="DynamicColor" name="grid-panel"><ui:Label usage-hints="DynamicColor" name="grid-status" class="body-copy"/><ui:VisualElement usage-hints="DynamicColor" name="tunnel" picking-mode="Ignore"><ui:VisualElement usage-hints="DynamicColor" name="tunnel-ring0" class="tunnel-ring"/><ui:VisualElement usage-hints="DynamicColor" name="tunnel-ring1" class="tunnel-ring"/><ui:VisualElement usage-hints="DynamicColor" name="tunnel-ring2" class="tunnel-ring"/><ui:VisualElement usage-hints="DynamicColor" name="tunnel-ring3" class="tunnel-ring"/></ui:VisualElement><ui:ProgressBar name="grid-progress" low-value="0" high-value="100"/><ui:VisualElement usage-hints="DynamicColor" name="grid-nodes"><ui:Button usage-hints="DynamicColor" name="node0" text="Crosswind Reach"/><ui:Button usage-hints="DynamicColor" name="node1" text="Drywater Works"/><ui:Button usage-hints="DynamicColor" name="node2" text="Beacon Dunes"/></ui:VisualElement><ui:Label usage-hints="DynamicColor" name="grid-selection" class="body-copy"/></ui:VisualElement>
    <ui:VisualElement usage-hints="DynamicColor" name="pause-panel"><ui:Button usage-hints="DynamicColor" name="resume" text="Return to the city"/><ui:Button usage-hints="DynamicColor" name="reset" text="Return to West Gate"/><ui:Button name="settings-button" text="Settings · Sound and video"/><ui:Button usage-hints="DynamicColor" name="mute" text="Mute audio"/><ui:Button usage-hints="DynamicColor" name="reduced-motion" text="Reduced motion: Off"/><ui:Button usage-hints="DynamicColor" name="reset-ui" text="Reset UI positions"/><ui:Button usage-hints="DynamicColor" name="credits-button" text="Credits and licences"/><ui:Button usage-hints="DynamicColor" name="quit" text="Quit game"/><ui:Label usage-hints="DynamicColor" text="WASD / arrows · Move     Shift · Run     Space · Jump&#10;Left-drag · Look     Wheel · Zoom / first person&#10;E · Interact     1–6 · Hotbar     R · Return to West Gate&#10;Drag frames / headers · Move UI     Ctrl-drag · Move from any control" class="controls-copy muted"/></ui:VisualElement>
    <ui:VisualElement usage-hints="DynamicColor" name="text-panel"><ui:Label usage-hints="DynamicColor" name="panel-text" class="body-copy"/></ui:VisualElement>
   </ui:ScrollView>
   <ui:Label usage-hints="DynamicColor" name="modal-notice" class="feedback"/>
   <ui:VisualElement usage-hints="DynamicColor" class="modal-footer" picking-mode="Ignore"><ui:Label usage-hints="DynamicColor" name="modal-footer-left" text="FREE COLUMN  /  ATHEN HILL" class="small muted"/><ui:Label usage-hints="DynamicColor" name="modal-footer-right" text="Tab · Select     Enter · Confirm" class="small muted"/></ui:VisualElement>
  </ui:VisualElement>
 </ui:VisualElement>
</ui:UXML>
