:root { color: rgb(232,221,197); font-size: 17px; -unity-font-style: normal; }
#hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.panel { background-color: rgba(23,32,32,0.94); border-width: 1px; border-color: rgb(103,113,106); border-radius: 2px; padding: 16px; }
.title { font-size: 28px; color: rgb(240,230,207); }
.muted { color: rgb(184,202,185); }
.small { font-size: 13px; }
#identity { position: absolute; top: 24px; left: 26px; }
#vitals { position: absolute; top: 120px; left: 26px; width: 150px; }
.vital-bar { height: 12px; background-color: rgb(175,89,75); margin-top: 5px; margin-bottom: 16px; }
.nano-bar { height: 12px; background-color: rgb(71,159,164); margin-top: 5px; }
#objective-box { position: absolute; top: 28px; left: 35%; width: 490px; padding: 12px; }
#progress { margin-top: 5px; }
#top-actions { position: absolute; top: 24px; right: 24px; flex-direction: row; }
Button { color: rgb(232,221,197); background-color: rgb(39,52,53); border-width: 1px; border-color: rgb(105,122,113); border-radius: 1px; min-height: 44px; padding: 10px 16px; margin: 4px; font-size: 16px; white-space: normal; }
Button:hover { background-color: rgb(51,77,74); border-color: rgb(110,191,185); }
Button:focus { border-color: rgb(188,242,225); border-width: 2px; }
Button:active { background-color: rgb(70,97,90); }
Button:disabled { color: rgb(129,146,135); background-color: rgb(30,40,40); border-color: rgb(63,75,68); }
#notice { position: absolute; top: 114px; left: 30%; width: 680px; white-space: normal; }
#nametags { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.nametag { position: absolute; width: 180px; -unity-text-align: middle-center; font-size: 16px; color: rgb(220,238,217); background-color: rgba(17,28,27,.85); padding: 5px; }
#interaction { position: absolute; left: 39%; width: 420px; bottom: 180px; }
#chat { position: absolute; bottom: 25px; left: 26px; width: 410px; height: 180px; overflow: hidden; }
#log { flex-shrink: 1; white-space: normal; font-size: 15px; margin-top: 10px; overflow: hidden; }
#quickbar { position: absolute; bottom: 25px; left: 28%; right: 16%; align-items: center; }
#hotbar { flex-direction: row; padding: 8px; }
#hotbar Button { width: 86px; height: 64px; }
.help { margin-top: 8px; font-size: 13px; color: rgb(232,221,197); background-color: rgba(17,28,27,.75); padding: 5px; }
#shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(8,16,16,.55); align-items: center; justify-content: center; }
#modal { width: 780px; max-height: 860px; padding: 28px; }
.modal-heading { flex-direction: row; align-items: center; justify-content: space-between; }
#modal-subtitle { margin-top: 5px; margin-bottom: 18px; }
.body-copy { white-space: normal; font-size: 19px; margin-top: 12px; margin-bottom: 20px; }
#dialogue-panel Button { -unity-text-align: middle-left; min-height: 56px; margin-top: 8px; }
.trade-row { flex-direction: row; align-items: center; border-top-width: 1px; border-top-color: rgb(70,88,79); padding-top: 15px; padding-bottom: 15px; }
.item-copy { flex-grow: 1; width: 300px; white-space: normal; }
.trade-row Button { width: 120px; }
#grid-nodes { margin-top: 20px; }
#grid-nodes Button { min-height: 70px; -unity-text-align: middle-left; }
#pause-panel Button { min-height: 48px; }
#text-panel { max-height: 510px; }
.feedback { white-space: normal; color: rgb(159,217,192); margin-top: 12px; }

#tunnel { height: 180px; overflow: hidden; background-color: rgb(9,26,28); margin-bottom: 16px; }
.tunnel-ring { position: absolute; border-width: 2px; border-color: rgb(65,187,178); border-radius: 30px; }
