/* User reference: worn bronze instrument frames, charcoal insets, ivory type, cyan state. */
:root { color: #eee9dc; font-size: 18px; -unity-font: url("Art/ColonySans.ttf"); -unity-font-definition: initial; -unity-font-style: normal; }
Label { margin: 0; padding: 0; }
#hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
#hud:disabled, #hud .unity-disabled { opacity: 1; }
.panel { background-image: url("Art/frame.png"); -unity-slice-left: 28; -unity-slice-right: 28; -unity-slice-top: 28; -unity-slice-bottom: 28; -unity-slice-scale: 1px; padding: 20px; }
.title { font-size: 30px; color: #eee9dc; }
.muted { color: #bcbcad; }
.small { font-size: 16px; }
#identity { position: absolute; top: 20px; left: 20px; width: 344px; height: 212px; padding: 20px 28px; }
.identity-heading { flex-direction: row; align-items: center; height: 65px; margin-bottom: 8px; }
.insignia { background-image: url("Art/insignia.png"); width: 71px; height: 64px; -unity-background-scale-mode: scale-to-fit; margin-right: 26px; }
.identity-title { font-size: 20px; margin-bottom: 3px; }
.identity-faction { font-size: 20px; }
#vitals { border-top-width: 1px; border-bottom-width: 1px; border-color: #65706a; padding-top: 8px; padding-bottom: 9px; margin-bottom: 5px; }
.vital-row { flex-direction: row; align-items: center; height: 26px; }
.vital-label { width: 79px; font-size: 14px; }
.meter { width: 119px; height: 12px; background-color: #101a1b; border-width: 1px; border-color: #0c1415; margin-right: 14px; }
.vital-bar { flex-grow: 1; background-color: #c65c4f; border-top-width: 1px; border-top-color: #db7d6b; }
.nano-bar { flex-grow: 1; background-color: #49cbd0; border-top-width: 1px; border-top-color: #86e6df; }
.vital-value { font-size: 16px; }
.district-title { font-size: 20px; }
.district-subtitle { font-size: 16px; }
#compass { position: absolute; top: 20px; left: 50%; margin-left: -300px; width: 600px; height: 47px; padding: 7px 18px; }
#compass-track { flex-grow: 1; overflow: hidden; }
.compass-tick { position: absolute; width: 1px; height: 7px; bottom: 1px; background-color: #adb6a5; }
.compass-tick.major { height: 10px; }
.compass-label { position: absolute; width: 34px; top: 0; -unity-text-align: upper-center; font-size: 18px; }
.compass-label.minor { font-size: 14px; color: #bcbcad; }
.compass-pointer { position: absolute; top: -8px; left: 50%; margin-left: -9px; width: 18px; height: 18px; }
.diamond { background-image: url("Art/diamond.png"); -unity-background-scale-mode: scale-to-fit; }
#objective-box { position: absolute; top: 20px; right: 20px; width: 446px; min-height: 116px; padding: 16px 26px 15px; }
.section-heading { flex-direction: row; flex-shrink: 0; align-items: center; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: #59615a; padding-bottom: 7px; margin-bottom: 7px; }
.signal { height: 3px; width: 80px; border-top-width: 1px; border-top-color: #72857a; border-left-width: 6px; border-left-color: #58d5d7; }
#objective { font-size: 21px; white-space: normal; }
.objective-progress { flex-direction: row; align-items: center; margin-top: 7px; }
#progress { flex-grow: 1; }
#progress-marks { flex-direction: row; }
.progress-mark { width: 20px; height: 20px; background-image: url("Art/diamond-empty.png"); margin-left: 12px; -unity-background-scale-mode: scale-to-fit; }
.progress-mark.complete { background-image: url("Art/diamond.png"); }
#top-actions { position: absolute; top: 143px; right: 20px; width: 446px; height: 50px; flex-direction: row; padding: 7px 11px; align-items: stretch; }
Button { color: #eee9dc; background-color: rgba(0,0,0,0); background-image: url("Art/button.png"); -unity-slice-left: 20; -unity-slice-right: 20; -unity-slice-top: 20; -unity-slice-bottom: 20; border-width: 0; border-radius: 0; min-height: 48px; padding: 12px 18px; margin: 4px 0; font-size: 18px; white-space: normal; -unity-font-style: normal; }
Button:hover { -unity-background-image-tint-color: #d0eeeb; color: #ffffff; }
Button:focus { background-image: url("Art/button-focus.png"); -unity-background-image-tint-color: #ffffff; }
Button:active { -unity-background-image-tint-color: #819b97; }
Button:disabled { color: #8c958b; -unity-background-image-tint-color: #7b8880; opacity: 0.65; }
#top-actions .utility { flex-direction: row; align-items: center; justify-content: center; flex-grow: 1; background-image: none; margin: 0; padding: 0 7px; min-height: 30px; font-size: 16px; border-left-width: 1px; border-left-color: #6a7066; }
#top-actions #inventory-button { border-left-width: 0; }
#top-actions .utility:hover, #top-actions .utility:focus { background-color: #364844; color: #8aedeb; }
.credit-readout { flex-direction: row; align-items: center; padding: 0 10px; font-size: 16px; border-left-width: 1px; border-left-color: #6a7066; }
.mini-icon { width: 23px; height: 23px; margin-right: 7px; -unity-background-scale-mode: scale-to-fit; }
.inventory-icon { background-image: url("Art/inventory.png"); }
.coins-icon { background-image: url("Art/coins.png"); }
.journal-icon { background-image: url("Art/journal.png"); }
.gear-icon { background-image: url("Art/gear.png"); }
#notice { position: absolute; top: 90px; left: 50%; margin-left: -300px; width: 600px; padding: 18px 28px; white-space: normal; font-size: 20px; -unity-text-align: middle-center; }
/* Warden radio: its own channel under the compass; notices drop below it while a line is up (CityHud). */
#radio { display: none; position: absolute; top: 90px; left: 50%; margin-left: -370px; width: 740px; padding: 14px 28px 16px; }
.radio-heading { flex-direction: row; align-items: center; margin-bottom: 6px; }
.radio-signal { width: 8px; height: 8px; background-color: #58d5d7; rotate: 45deg; margin-right: 12px; }
.radio-speaker { color: #8be6df; letter-spacing: 2px; }
.radio-text { font-size: 20px; white-space: normal; color: #eee9dc; }
.compact #radio { width: 640px; margin-left: -320px; }
.small-window .radio-text, .small-window .radio-speaker { font-size: 20px; }
#nametags { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.nametag { position: absolute; width: 200px; flex-direction: row; align-items: flex-start; padding: 4px 7px; }
.nametag-marker { width: 22px; height: 22px; margin-top: 2px; margin-right: 8px; }
.nametag-copy { font-size: 17px; color: #f3f0e7; background-color: rgba(12,20,19,0.78); padding: 3px 8px; white-space: normal; }
#interaction { position: absolute; left: 50%; margin-left: -190px; width: 380px; bottom: 187px; background-image: url("Art/frame.png"); -unity-slice-left: 28; -unity-slice-right: 28; -unity-slice-top: 28; -unity-slice-bottom: 28; padding: 15px 24px; min-height: 53px; color: #a7efea; }
#chat { position: absolute; bottom: 20px; left: 20px; width: 430px; height: 188px; padding: 15px 22px 12px; overflow: hidden; }
.channel-title { color: #6ce1e0; font-size: 18px; }
#log-scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; margin-bottom: 5px; }
#log-scroll .unity-scroll-view__content-viewport { overflow: hidden; }
#log { white-space: normal; font-size: 18px; color: #e1dcc9; }
.chat-footer { flex-direction: row; flex-shrink: 0; align-items: center; border-top-width: 1px; border-top-color: #59615a; padding-top: 8px; }
.chat-footer .mini-icon { width: 18px; height: 18px; margin-right: 13px; }
#quickbar { position: absolute; bottom: 20px; left: 50%; margin-left: -344px; width: 688px; height: 90px; }
#hotbar { flex-direction: row; padding: 18px 12px 8px; flex-grow: 1; -unity-slice-scale: 0.5px; }
#hotbar .hotbar-slot { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; height: 64px; margin: 0 1px; padding: 2px 4px 0; align-items: center; justify-content: flex-end; -unity-slice-scale: 0.5px; }
.hotbar-slot.selected { background-image: url("Art/button-focus.png"); }
.item-art { width: 44px; height: 44px; -unity-background-scale-mode: scale-to-fit; }
.flask-icon { background-image: url("Art/flask.png"); }
.medkit-icon { background-image: url("Art/medkit.png"); }
.lattice-icon { background-image: url("Art/lattice.png"); }
.talk-icon { background-image: url("Art/talk.png"); }
.pack-icon { background-image: url("Art/pack.png"); }
.notes-icon { background-image: url("Art/notes.png"); }
.scrap-icon { background-image: url("Art/scrap.png"); }
/* Gameplay v2 salvage, parts and pistol mods (refs/ui_20260930/items). */
.alloy-icon { background-image: url("Art/alloy.png"); }
.nanites-icon { background-image: url("Art/nanites.png"); }
.copper-icon { background-image: url("Art/copper.png"); }
.servo-icon { background-image: url("Art/servo.png"); }
.capacitor-icon { background-image: url("Art/capacitor.png"); }
.optic-icon { background-image: url("Art/optic.png"); }
.actuator-icon { background-image: url("Art/actuator.png"); }
.shard-icon { background-image: url("Art/shard.png"); }
.control-core-icon { background-image: url("Art/control-core.png"); }
.alloy-plate-icon { background-image: url("Art/alloy-plate.png"); }
.wound-coil-icon { background-image: url("Art/wound-coil.png"); }
.charge-core-icon { background-image: url("Art/charge-core.png"); }
.grip-mk1-icon { background-image: url("Art/grip-mk1.png"); }
.barrel-mk1-icon { background-image: url("Art/barrel-mk1.png"); }
.cell-mk1-icon { background-image: url("Art/cell-mk1.png"); }
.grip-mk2-icon { background-image: url("Art/grip-mk2.png"); }
.barrel-mk2-icon { background-image: url("Art/barrel-mk2.png"); }
.cell-mk2-icon { background-image: url("Art/cell-mk2.png"); }
.hotbar-slot .talk-icon { width: 34px; height: 38px; margin-bottom: 6px; }
.keycap { position: absolute; top: 3px; left: 3px; width: 16px; height: 18px; border-width: 1px; border-color: #82948b; border-radius: 2px; background-color: #101a1b; -unity-text-align: middle-center; font-size: 14px; }
.slot-label { height: 18px; flex-shrink: 0; width: 100%; border-top-width: 1px; border-top-color: #5c6c64; -unity-text-align: middle-center; font-size: 14px; white-space: nowrap; }
.empty-slot-marker { flex-grow: 1; -unity-text-align: middle-center; font-size: 17px; color: #68786e; }
.window-drag-grip { position: absolute; left: 50%; margin-left: -18px; top: 5px; width: 36px; height: 7px; border-top-width: 1px; border-bottom-width: 1px; border-color: #a48a62; }
.window-drag-grip:hover, .window-dragging > .window-drag-grip { border-color: #73e8e4; }
#key-hints { position: absolute; right: 20px; bottom: 24px; flex-direction: row; }
.hint { flex-direction: row; align-items: center; justify-content: center; height: 50px; min-height: 50px; padding: 10px 15px; margin: 0 0 0 5px; font-size: 18px; }
.hint-key { border-width: 1px; border-color: #7f9187; border-radius: 2px; padding: 1px 5px; margin-right: 12px; background-color: #101a1b; }
#shade { display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(5,11,12,0.66); align-items: center; justify-content: center; }
#modal { width: 860px; max-height: 88%; padding: 27px 32px 22px; }
.modal-heading { flex-direction: row; flex-shrink: 0; align-items: center; padding-bottom: 15px; border-bottom-width: 1px; border-bottom-color: #7b8275; }
.modal-emblem { width: 25px; height: 25px; margin-right: 13px; }
#modal-title { flex-grow: 1; }
#close { font-size: 17px; margin: 0; min-height: 43px; padding: 10px 20px; }
#modal-subtitle { flex-shrink: 0; font-size: 18px; margin-top: 10px; margin-bottom: 17px; }
#modal-scroll { flex-shrink: 1; min-height: 0; max-height: 620px; }
.body-copy { white-space: normal; font-size: 22px; margin-top: 12px; margin-bottom: 22px; }
#dialogue-text { min-height: 94px; padding: 16px 2px 8px; }
.response-heading { margin: 9px 0 6px; }
#dialogue-panel Button { -unity-text-align: middle-left; min-height: 59px; padding: 17px 24px; margin-top: 8px; }
.balance { color: #daca9e; font-size: 22px; margin: 3px 0 18px; }
.trade-row { flex-direction: row; align-items: center; border-top-width: 1px; border-top-color: #535f58; padding: 14px 0; min-height: 124px; }
.trade-art { width: 86px; height: 91px; flex-shrink: 0; margin-right: 17px; -unity-background-scale-mode: scale-to-fit; }
.item-copy { flex-grow: 1; flex-shrink: 1; flex-basis: 0; white-space: normal; font-size: 20px; margin-right: 17px; }
.trade-row Button { width: 110px; margin-left: 9px; padding: 12px 9px; }
.trade-help { margin-top: 13px; white-space: normal; }
.quantity { width: 104px; color: #daca9e; font-size: 21px; -unity-text-align: middle-right; }

/* Field pack, after the user's Ark-style reference (30 Sep 2026; PackPanel.cs, CharacterPreview.cs).
   Three instrument panels inside the bronze modal: pack grid | colonist and loadout | turnable colonist view.
   Panels are deep teal enamel with thin cyan rules; cyan marks focus and selection, bronze marks headings,
   rarity keeps its colours (Common warm white, Uncommon cyan, Rare amber). The adjacent inspector keeps the grid live. */
#modal.pack-modal { width: 1740px; max-width: 97%; }
#modal.pack-modal #modal-scroll { max-height: 700px; }
#modal.pack-modal #modal-subtitle { margin-bottom: 12px; }
#inventory-content { flex-direction: row; align-items: stretch; height: 680px; }
.tech-panel { background-color: rgba(8, 25, 29, 0.94); border-width: 1px; border-color: #2c5a5f; border-top-color: #3d7479; padding: 12px 14px 12px; }
.pack-col { width: 450px; flex-shrink: 0; }
.you-col { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 470px; margin-left: 10px; }
.character-legacy-hidden { display: none; }
.character-loadout { flex-grow: 1; min-height: 0; }
.character-tabs { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: #2c5a5f; padding-bottom: 5px; }
.character-tab { flex-grow: 1; font-size: 14px; height: 30px; min-width: 74px; margin: 0 3px 3px 0; padding: 2px 5px; background-image: none; background-color: #10292e; border-width: 1px; border-color: #426166; color: #c4d1ca; letter-spacing: 0; }
.character-tab.active-tab { border-color: #58d5d7; color: #eee9dc; background-color: #1a434a; }
.character-tab:focus, .character-action:focus, .character-slot:focus, .character-stat-increase:focus { border-color: #58d5d7; }
.character-capacity { font-size: 14px; white-space: normal; padding: 8px 0; color: #c4d1ca; }
.character-capacity.overburdened { color: #f0b99e; }
.character-vitals { font-size: 15px; white-space: normal; padding-bottom: 8px; color: #c4d1ca; }
.character-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.character-heading { font-size: 16px; color: #bca581; margin: 12px 0 7px; letter-spacing: 0; }
.character-slot { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 67px; margin: 0 3px 6px 0; padding: 5px 8px; background-image: none; background-color: #0f2a30; border-width: 1px; border-color: #426166; border-radius: 0; }
.character-slot:hover, .character-slot.selected { background-color: #1a434a; border-color: #58d5d7; }
.character-slot.empty { background-color: #0b2025; }
.character-slot-icon { width: 48px; height: 48px; flex-shrink: 0; margin-right: 10px; -unity-background-scale-mode: scale-to-fit; }
.character-slot.empty .character-slot-icon { opacity: 0.8; }
.character-slot-empty-mark { -unity-text-align: middle-center; color: #72cbd1; font-size: 28px; padding: 0; margin-top: 0; margin-bottom: 0; }
.character-slot-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.character-slot-label { font-size: 14px; color: #bca581; white-space: normal; }
.character-slot-value { font-size: 18px; color: #eee9dc; white-space: normal; }
.character-selection { font-size: 16px; color: #bca581; margin-top: 7px; white-space: normal; }
.character-actions { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-top: 5px; }
.character-action { flex-grow: 1; height: 33px; font-size: 16px; margin: 0 4px 4px 0; padding: 3px 7px; }
.character-result { font-size: 16px; min-height: 42px; color: #a5d8c2; white-space: normal; margin-top: 4px; }
.character-result.rejected { color: #f0b99e; }
.equipment-description { font-size: 14px; color: #bdccc4; white-space: normal; margin: 0 4px 8px; }
.character-stat-row { flex-direction: row; align-items: center; min-height: 34px; flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: #29454a; font-size: 17px; }
.character-stat-name { flex-grow: 1; flex-shrink: 1; white-space: normal; }
.character-stat-name Label { white-space: normal; }
.character-stat-increase { width: 29px; height: 27px; margin-left: 8px; font-size: 20px; padding: 0; }
.character-breakdown { font-size: 16px; margin: 5px 0; }
.character-breakdown Label { white-space: normal; }
.equipment-drag-ghost { position: absolute; max-width: 280px; padding: 8px 12px; background-color: #16373e; border-width: 1px; border-color: #58d5d7; color: #eee9dc; font-size: 18px; white-space: normal; }
.small-window .character-tab { font-size: 18px; min-width: 90px; height: 34px; }
.small-window .character-capacity, .small-window .character-slot-label, .small-window .equipment-description, .small-window .character-result { font-size: 18px; }
.preview-col { width: 260px; flex-shrink: 0; margin-left: 10px; }
.inventory-details { width: 252px; flex-shrink: 0; margin-left: 10px; }

/* Tabs: large caps lettering over a cyan underline, like the reference's INVENTORY / YOU headers. */
.pack-tabs { flex-direction: row; flex-shrink: 0; align-items: flex-end; height: 42px; margin-bottom: 8px; border-bottom-width: 1px; border-bottom-color: #2c5a5f; }
.pack-tab, .pack-tab-label { font-size: 22px; letter-spacing: 1px; color: #7f9a98; background-image: none; background-color: rgba(0,0,0,0); min-height: 0; height: 40px; margin: 0 22px -1px 0; padding: 4px 0 0; border-bottom-width: 3px; border-color: rgba(0,0,0,0); -unity-text-align: middle-left; }
.pack-tab:hover { color: #d6f4f1; background-color: rgba(0,0,0,0); }
.pack-tab:focus { background-image: none; color: #eee9dc; border-bottom-color: #8be6df; }
.pack-tab.active-tab, .pack-tab-label.active-tab { color: #eee9dc; border-bottom-color: #58d5d7; }
.pack-credit-readout { flex-grow: 1; flex-direction: row; align-items: center; justify-content: flex-end; margin-bottom: 8px; }
.pack-credit { font-size: 20px; color: #daca9e; }

/* Search and filter chips. */
.pack-tools { flex-direction: row; flex-shrink: 0; align-items: center; margin-bottom: 10px; }
.pack-search-box { width: 176px; height: 36px; flex-shrink: 0; flex-direction: row; align-items: center; background-color: #0c2227; border-width: 1px; border-color: #2c5a5f; margin-right: 10px; }
.pack-search-box.focused { border-color: #58d5d7; }
.pack-search-glyph { width: 12px; height: 12px; margin: 0 4px 0 10px; border-width: 2px; border-color: #7f9a98; border-radius: 6px; flex-shrink: 0; }
.pack-search { flex-grow: 1; margin: 0; padding: 0; font-size: 17px; }
.pack-search > .unity-base-text-field__input, .pack-search .unity-text-field__input { background-color: rgba(0,0,0,0); border-width: 0; color: #eee9dc; padding: 4px 6px; -unity-font: url("Art/ColonySans.ttf"); -unity-font-definition: initial; --unity-cursor-color: #8be6df; --unity-selection-color: rgba(88,213,215,0.35); }
.pack-search-placeholder { position: absolute; left: 30px; top: 7px; font-size: 17px; color: #6f8987; }
.pack-filters { flex-direction: row; flex-grow: 1; flex-wrap: nowrap; }
.pack-chip { font-size: 15px; min-height: 0; height: 36px; margin: 0 6px 0 0; padding: 0 11px; background-image: none; background-color: #0c2227; border-width: 1px; border-color: #2c5a5f; color: #aebdb8; letter-spacing: 1px; -unity-text-align: middle-center; }
.pack-chip:hover { background-color: #15353b; color: #eee9dc; }
.pack-chip:focus { background-image: none; border-color: #8be6df; color: #eee9dc; }
.pack-chip.active-chip { background-color: #173f45; border-color: #58d5d7; color: #eee9dc; }

/* Item grid: dense square cells; the grid is always filled out with empty cells like a pack, never implying a capacity. */
#inventory-scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; }
#inventory-scroll .unity-scroll-view__content-container { flex-direction: column; }
#inventory-grid { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.inventory-empty { display: none; flex-direction: column; padding: 18px 6px; }
#inventory-empty-subtitle { font-size: 18px; margin-top: -6px; }
.inventory-tile, .pack-cell { width: 64px; height: 64px; margin: 0 5px 5px 0; padding: 0; background-image: none; background-color: #0f2a30; border-width: 1px; border-color: #2a5157; border-radius: 0; justify-content: center; align-items: center; min-height: 0; }
.pack-cell { background-color: #0b2025; border-color: #1c3a3f; }
.inventory-tile:hover { background-color: #16373e; border-color: #4aa9ad; }
.inventory-tile:focus, .inventory-tile.selected { background-image: none; background-color: #1a434a; border-color: #58d5d7; }
.inventory-tile:focus { border-width: 2px; border-color: #8be6df; }
.inventory-tile-icon { width: 47px; height: 47px; margin-top: -5px; -unity-background-scale-mode: scale-to-fit; }
.inventory-tile-qty { position: absolute; right: 5px; bottom: 5px; font-size: 14px; color: #eee9dc; text-shadow: 1px 1px 1px rgba(0,0,0,0.9); }
.inventory-tile-name { display: none; position: absolute; left: 3px; right: 3px; bottom: 7px; font-size: 14px; color: #e6e1d3; -unity-text-align: lower-center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-shadow: 1px 1px 1px rgba(0,0,0,0.95); }
.inventory-tile-bar { position: absolute; left: 4px; right: 4px; bottom: 3px; height: 3px; background-color: #30494c; }
.inventory-tile.tile-uncommon .inventory-tile-bar { background-color: #58d5d7; }
.inventory-tile.tile-rare .inventory-tile-bar { background-color: #e7a94a; }
.inventory-tile.short .inventory-tile-icon { opacity: 0.45; }
.inventory-tile.short .inventory-tile-bar { background-color: #6b3e38; }
.inventory-tile.ready .inventory-tile-bar { background-color: #58d5d7; }

/* Selected item: a strip under the grid, like the reference's hover card. */
.inventory-overview { flex-direction: row; flex-shrink: 0; height: 120px; margin-top: 8px; padding-top: 10px; border-top-width: 1px; border-top-color: #2c5a5f; }
.inventory-overview-frame { width: 92px; height: 92px; flex-shrink: 0; margin-right: 14px; background-color: #0f2a30; border-width: 1px; border-color: #2a5157; align-items: center; justify-content: center; }
.inventory-overview-icon { width: 76px; height: 76px; -unity-background-scale-mode: scale-to-fit; }
.inventory-overview-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.inventory-overview-name { font-size: 21px; white-space: normal; }
.inventory-overview-quantity { font-size: 15px; letter-spacing: 1px; margin-top: 1px; }
.inventory-overview-description { white-space: normal; font-size: 17px; margin-top: 5px; color: #d7d3c6; overflow: hidden; }
.pack-footer { flex-direction: row; flex-shrink: 0; justify-content: space-between; align-items: center; height: 34px; margin-top: 6px; padding: 0 10px; background-color: #0c2227; border-width: 1px; border-color: #2c5a5f; }
.pack-filter-name { font-size: 15px; letter-spacing: 1px; color: #eee9dc; }
.pack-summary { font-size: 15px; }

/* YOU: loadout slots flank the colonist card; progress runs under it like an experience bar; stats follow. */
.loadout { flex-direction: row; flex-shrink: 0; align-items: stretch; }
.loadout-slots { width: 92px; flex-shrink: 0; }
.loadout-slot { margin-bottom: 8px; }
.loadout-slot-label { font-size: 14px; color: #a48a62; letter-spacing: 1px; margin-bottom: 3px; -unity-text-align: middle-center; }
.loadout-cell { width: 92px; height: 92px; background-color: #0f2a30; border-width: 1px; border-color: #2a5157; align-items: center; justify-content: center; }
.loadout-cell:hover { background-color: #16373e; border-color: #4aa9ad; }
.loadout-cell.empty { background-color: #0b2025; border-color: #1c3a3f; }
.loadout-cell.selected { border-color: #58d5d7; background-color: #1a434a; }
.loadout-cell-icon { width: 66px; height: 66px; -unity-background-scale-mode: scale-to-fit; }
.loadout-cell-empty { font-size: 14px; color: #5f7a78; letter-spacing: 1px; }
.loadout-cell .inventory-tile-bar { bottom: 3px; }
.loadout-cell.tile-uncommon .inventory-tile-bar { background-color: #58d5d7; }
.loadout-cell.tile-rare .inventory-tile-bar { background-color: #e7a94a; }
.colonist-card { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 20px 10px 8px; padding: 10px 12px 8px; background-color: #0e2c32; border-width: 1px; border-color: #2c5a5f; }
.colonist-name { font-size: 21px; -unity-text-align: upper-center; }
.colonist-faction { font-size: 15px; color: #58d5d7; letter-spacing: 2px; -unity-text-align: upper-center; margin-bottom: 7px; padding-bottom: 7px; border-bottom-width: 1px; border-bottom-color: #2c5a5f; }
.colonist-fact { flex-direction: row; justify-content: space-between; height: 25px; align-items: center; }
.colonist-fact-label { font-size: 14px; color: #9fb1ad; letter-spacing: 1px; }
.colonist-fact-value { font-size: 16px; color: #eee9dc; -unity-text-align: middle-right; }
.you-progress { flex-shrink: 0; margin: 4px 0 14px; }
.you-progress-row { flex-direction: row; justify-content: space-between; margin-bottom: 4px; }
.you-progress-label { font-size: 15px; color: #a48a62; letter-spacing: 1px; }
.you-progress-value { font-size: 15px; color: #eee9dc; }
.you-progress-track { height: 9px; background-color: #0b2025; border-width: 1px; border-color: #2c5a5f; }
.you-progress-fill { height: 100%; width: 0; background-color: #c9ab63; border-top-width: 1px; border-top-color: #e6cf8e; }
.you-stats { flex-grow: 1; flex-shrink: 1; min-height: 0; overflow: hidden; }
.you-stat { flex-direction: row; align-items: center; height: 37px; padding: 0 8px; margin-bottom: 4px; background-color: #0e262b; border-width: 1px; border-color: #1f4247; }
.you-stat.vital { height: 46px; flex-direction: column; align-items: stretch; justify-content: center; }
.you-stat-line { flex-direction: row; align-items: center; }
.you-stat-mark { width: 11px; height: 11px; margin-right: 9px; rotate: 45deg; scale: 0.8 0.8; background-color: #a48a62; flex-shrink: 0; }
.you-stat.vital .you-stat-mark { background-color: #58d5d7; }
.you-stat.vitality .you-stat-mark { background-color: #c65c4f; }
.you-stat-name { flex-grow: 1; font-size: 15px; letter-spacing: 1px; color: #dcd8cb; }
.you-stat-value { font-size: 16px; color: #eee9dc; -unity-text-align: middle-right; }
.you-stat-delta { width: 62px; font-size: 14px; -unity-text-align: middle-right; color: #8c958b; }
.you-stat-delta.better { color: #8fcf8a; }
.you-stat-delta.worse { color: #db7d6b; }
.you-stat-track { height: 6px; margin: 4px 0 0 20px; background-color: #0b1b1f; border-width: 1px; border-color: #1c3a3f; }
.you-stat-fill { height: 100%; width: 100%; background-color: #49cbd0; border-top-width: 1px; border-top-color: #86e6df; }
.you-stat.vitality .you-stat-fill { background-color: #c65c4f; border-top-color: #db7d6b; }
.you-stat-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.you-stat-cell { width: 49.3%; padding: 0 6px 0 8px; }
.you-stat-cell .you-stat-name { font-size: 14px; letter-spacing: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; min-width: 0; }
.you-stat-cell .you-stat-delta { width: 50px; flex-shrink: 0; }
.you-stat-cell .you-stat-value { flex-shrink: 0; margin-left: 4px; }
.you-stat-heading { flex-direction: row; justify-content: space-between; font-size: 14px; color: #a48a62; letter-spacing: 1px; margin: 12px 0 5px; }
.you-stat-note { font-size: 16px; color: #9fb1ad; white-space: normal; margin: 4px 2px; }

/* Colonist view: rendered colonist over a faint dot grid, with bracket corners like the reference. */
.preview-col { padding: 0; background-image: url("Art/preview-grid.png"); background-repeat: repeat repeat; background-size: 22px 22px; background-color: #0a2126; }
.preview-view { position: absolute; left: 10px; right: 10px; top: 16px; bottom: 44px; -unity-background-scale-mode: scale-to-fit; }
.preview-fallback { position: absolute; left: 25%; right: 25%; top: 30%; bottom: 40%; opacity: 0.35; margin: 0; width: auto; height: auto; }
.preview-corner { position: absolute; width: 26px; height: 26px; border-color: #58d5d7; }
.preview-corner.tl { left: 8px; top: 8px; border-left-width: 2px; border-top-width: 2px; }
.preview-corner.tr { right: 8px; top: 8px; border-right-width: 2px; border-top-width: 2px; }
.preview-corner.bl { left: 8px; bottom: 8px; border-left-width: 2px; border-bottom-width: 2px; }
.preview-corner.br { right: 8px; bottom: 8px; border-right-width: 2px; border-bottom-width: 2px; }
.preview-caption { position: absolute; left: 20px; right: 20px; bottom: 16px; flex-direction: row; justify-content: space-between; align-items: flex-end; }
.preview-name { font-size: 15px; letter-spacing: 2px; color: #eee9dc; }
.preview-hint { font-size: 14px; }

/* The item inspector sits immediately beside the grid, independent of the selected loadout tab. */
.inventory-details { display: none; padding: 14px 16px 12px; }
.details-heading { padding-bottom: 10px; border-bottom-color: #2c5a5f; }
.details-heading #details-title { font-size: 23px; flex-shrink: 1; white-space: normal; margin-right: 12px; }
.details-heading #details-close { flex-shrink: 0; min-height: 40px; padding: 9px 14px; font-size: 16px; margin: 0; }
.details-body { flex-direction: column; flex-grow: 1; min-height: 0; margin-top: 12px; }
.details-icon-frame { width: 176px; height: 176px; align-self: center; margin-bottom: 12px; background-color: #0f2a30; border-width: 1px; border-color: #2a5157; align-items: center; justify-content: center; }
.details-icon { width: 150px; height: 150px; -unity-background-scale-mode: scale-to-fit; }
#details-quantity { font-size: 17px; }
#details-prices { margin-top: 2px; }
#details-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; margin-top: 10px; }
#details-scroll .unity-scroll-view__content-viewport { overflow: hidden; }
#details-description { font-size: 19px; margin-top: 0; margin-bottom: 0; }

/* Small windows: text grows to 20 reference pixels; cell names give way to the selected-item strip. */
.small-window .inventory-tile-name { display: none; }
.small-window .pack-chip, .small-window .pack-filter-name, .small-window .pack-summary, .small-window .colonist-fact-label, .small-window .you-stat-name, .small-window .you-progress-label, .small-window .you-progress-value, .small-window .preview-name, .small-window .preview-hint, .small-window .loadout-slot-label, .small-window .inventory-overview-quantity, .small-window .inventory-tile-qty, .small-window .you-stat-delta, .small-window .you-stat-cell .you-stat-name, .small-window .loadout-cell-empty, .small-window .you-stat-heading { font-size: 20px; }
.small-window .pack-chip { padding: 0 8px; margin-right: 4px; letter-spacing: 0; }
.small-window .colonist-fact-value, .small-window .you-stat-value, .small-window .inventory-overview-description, .small-window #details-description, .small-window .pack-search, .small-window .pack-search-placeholder { font-size: 20px; }
.small-window .colonist-fact { height: 26px; }
.small-window .you-stat { height: 32px; margin-bottom: 3px; }
.small-window .you-stat.vital { height: 40px; }
.small-window .you-progress { margin: 2px 0 10px; }
.small-window .you-stat-heading { margin: 8px 0 4px; }
.small-window .you-stat-cell .you-stat-delta { display: none; }
.small-window .pack-search-box { width: 150px; }
/* Ashfall inventory revision, 2 Oct 2026. The references specify compact equipment instruments:
   the pack and its inspector stay adjacent; implants use a static anatomical scan, weapons and armour a real preview. */
#modal.pack-modal #modal-subtitle { margin-bottom: 8px; }
#inventory-content { height: 690px; }
.pack-tools { flex-direction: column; align-items: stretch; }
.pack-search-box { width: auto; margin-right: 0; margin-bottom: 8px; }
.pack-filters { flex-wrap: wrap; }
.pack-chip { font-size: 14px; letter-spacing: 0; height: 30px; padding: 0 8px; margin-right: 4px; margin-bottom: 4px; flex-grow: 1; }
.pack-tab, .pack-tab-label { font-size: 20px; letter-spacing: 0.5px; }
.pack-credit { font-size: 18px; }
.pack-search-placeholder { color: #aebfba; }
.pack-capacity { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; padding: 3px 0 10px; margin-bottom: 7px; border-bottom-width: 1px; border-bottom-color: #29454a; }
.pack-capacity-meter { width: 50%; padding-right: 12px; }
.pack-capacity-value { font-size: 16px; color: #e5e8dc; margin-bottom: 5px; }
.pack-capacity-track { height: 4px; background-color: #243f44; }
.pack-capacity-fill { height: 4px; background-color: #58d5d7; }
.pack-capacity-fill.capacity-full { background-color: #d8ac72; }
.pack-capacity-help { width: 100%; white-space: normal; font-size: 14px; color: #bdccc4; margin-top: 6px; }
.inventory-overview { display: none; }
.inventory-details { padding: 12px; }
.details-heading { min-height: 43px; margin-bottom: 0; }
.details-heading .modal-emblem { display: none; }
.details-heading #details-title { font-size: 24px; margin-right: 0; }
.details-heading #details-close { display: none; }
.details-icon-frame { width: 176px; height: 156px; border-width: 0; background-color: transparent; }
.details-icon { width: 170px; height: 150px; }
#details-quantity { font-size: 16px; white-space: normal; color: #d4ded6; margin-bottom: 10px; }
#details-prices { font-size: 16px; white-space: normal; color: #daca9e; }
#details-description { font-size: 17px; }
.character-capacity { display: none; }
.character-vitals { font-size: 14px; padding-top: 7px; padding-bottom: 6px; }
.character-tab { font-size: 15px; min-width: 74px; height: 32px; }
.character-scroll .unity-scroll-view__content-container { flex-grow: 1; }
.character-scroll .unity-scroll-view__content-container > * { flex-shrink: 0; }
.equipment-inspector > *, .augmentation-details > * { flex-shrink: 0; }
.character-result { min-height: 22px; font-size: 15px; }
.character-slot { min-height: 52px; padding: 4px 6px; margin-bottom: 6px; }
.character-slot-icon { width: 36px; height: 36px; margin-right: 7px; }
.character-slot-label { font-size: 13px; }
.character-slot-value { font-size: 16px; }
.character-actions { margin-top: 2px; }
.character-action { height: 32px; font-size: 15px; }
.character-selection { font-size: 14px; margin-top: 4px; }
.character-heading { font-size: 15px; margin: 10px 0 6px; }
.character-breakdown { font-size: 16px; margin-top: 3px; margin-bottom: 3px; }
.weapon-picture { height: 162px; min-height: 162px; margin: 4px 18px 8px; -unity-background-scale-mode: scale-to-fit; }
.weapon-picture.rifle-icon { background-size: 470px 470px; background-position: center center; background-repeat: no-repeat no-repeat; }
.weapon-sockets { flex-direction: row; flex-wrap: wrap; }
.weapon-socket { width: 31%; flex-grow: 1; min-width: 103px; min-height: 90px; flex-direction: column; align-items: center; margin-right: 5px; }
.weapon-socket .character-slot-icon { width: 38px; height: 38px; margin: 0 0 4px; }
.weapon-socket .character-slot-copy { align-items: center; }
.weapon-socket .character-slot-value { font-size: 14px; -unity-text-align: middle-center; }
.anatomy-layout { flex-direction: row; flex-grow: 0; flex-shrink: 0; overflow: hidden; }
.anatomy-map { width: 306px; min-width: 306px; height: 100%; flex-shrink: 0; position: relative; margin-right: 12px; }
.anatomy-image { position: absolute; top: 0; left: 0; right: 0; bottom: 0; opacity: 0.9; }
.armour-anatomy-image { opacity: 0.5; }
.anatomy-slot { position: absolute; width: 112px; min-height: 50px; height: 50px; margin: -25px 0 0; padding: 4px; background-color: rgba(7, 29, 35, 0.98); }
.anatomy-slot .character-slot-icon { width: 23px; height: 28px; margin-right: 4px; }
.anatomy-slot .character-slot-label { font-size: 13px; white-space: nowrap; }
.anatomy-slot .character-slot-value { font-size: 13px; max-height: 29px; overflow: hidden; text-overflow: ellipsis; }
.anatomy-leader { position: absolute; width: 25px; height: 1px; background-color: #58b9c2; }
.anatomy-node { position: absolute; width: 9px; height: 9px; margin-top: -4px; border-width: 1px; border-color: #83e2e3; background-color: #16434b; border-radius: 5px; }
.equipment-inspector-scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 170px; height: 100%; border-left-width: 1px; border-left-color: #294f56; }
.equipment-inspector-scroll .unity-scroll-view__content-viewport { overflow: hidden; }
.equipment-inspector { flex-grow: 1; flex-shrink: 0; min-width: 0; padding: 3px 5px 8px 9px; }
.equipment-inspector-heading { color: #8fdbdf; font-size: 14px; white-space: normal; margin-bottom: 5px; }
.equipment-inspector-title { color: #eee9dc; font-size: 23px; white-space: normal; margin-bottom: 8px; }
.equipment-inspector-icon { height: 92px; width: 112px; align-self: center; -unity-background-scale-mode: scale-to-fit; margin-bottom: 8px; }
.equipment-description { font-size: 15px; }
.modification-sockets { flex-direction: row; flex-wrap: wrap; }
.modification-socket { min-width: 65px; flex-basis: 30%; flex-grow: 1; flex-direction: column; align-items: center; min-height: 94px; margin-right: 4px; padding: 5px 3px; }
.modification-socket .character-slot-icon { width: 32px; height: 32px; margin-right: 0; margin-bottom: 4px; }
.modification-socket .character-slot-copy { align-items: center; }
.modification-socket .character-slot-label, .modification-socket .character-slot-value { font-size: 13px; -unity-text-align: middle-center; }
.augmentation-details { padding: 12px 8px 7px; margin-top: 10px; background-color: #102d34; border-width: 1px; border-color: #43818a; }
.augmentation-details .equipment-inspector-title { font-size: 20px; }
.preview-col { background-color: #081d22; }
.preview-caption { flex-direction: column; align-items: flex-start; left: 16px; right: 16px; }
.preview-name { font-size: 17px; white-space: normal; letter-spacing: 0; }
.preview-hint { font-size: 14px; color: #bdccc4; white-space: normal; }
.small-window .pack-search-box { width: auto; }
.small-window .pack-chip { font-size: 17px; }
.small-window .pack-capacity-value { font-size: 18px; }
.small-window .inventory-tile-qty { font-size: 17px; }
.small-window .character-tab { font-size: 17px; min-width: 80px; }
.small-window .character-slot-label, .small-window .equipment-description, .small-window .character-result { font-size: 16px; }
.small-window .anatomy-slot .character-slot-label { font-size: 13px; }
.small-window .anatomy-slot .character-slot-value { font-size: 14px; }
#grid-nodes { margin-top: 20px; }
#grid-nodes Button { min-height: 76px; padding: 16px 25px; -unity-text-align: middle-left; font-size: 20px; }
#pause-panel Button { min-height: 49px; padding: 12px 25px; }
#resume { color: #8be6df; }
.controls-copy { margin: 18px 6px 10px; font-size: 18px; white-space: normal; }
#text-panel { padding: 0 7px; }
.feedback { flex-shrink: 0; white-space: normal; color: #8be6df; font-size: 18px; margin-top: 14px; }
#modal-footer-left, #modal-footer-right { white-space: pre; }
.modal-footer { flex-direction: row; flex-shrink: 0; justify-content: space-between; border-top-width: 1px; border-top-color: #59615a; padding-top: 14px; margin-top: 18px; }
#tunnel { height: 180px; overflow: hidden; background-color: #101f22; margin-bottom: 16px; border-width: 1px; border-color: #586f67; }
.tunnel-ring { position: absolute; border-width: 2px; border-color: #4ababb; border-radius: 12px; }
#grid-progress { height: 23px; margin: 8px 0; }
.unity-progress-bar__container { background-color: #0c191b; border-width: 1px; border-color: #78877c; border-radius: 0; }
.unity-progress-bar__background { background-color: #122528; border-radius: 0; }
.unity-progress-bar__progress { background-color: #41aaac; border-radius: 0; }
.unity-progress-bar__title { color: #f1f0de; font-size: 15px; }
.unity-scroller--vertical { width: 12px; margin-left: 6px; }
.unity-scroller .unity-base-slider__tracker { background-color: #122022; border-width: 1px; border-color: #485952; }
.unity-scroller .unity-base-slider__dragger { background-color: #78877a; border-width: 1px; border-color: #a0b2a0; border-radius: 1px; min-width: 8px; }
.unity-scroller .unity-base-slider__dragger-border { display: none; }
.unity-scroller .unity-base-slider__dragger:hover { background-color: #58d5d7; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.compact #identity { width: 325px; }
.compact #compass { width: 400px; margin-left: -220px; }
.compact #objective-box, .compact #top-actions { width: 380px; }
.compact #objective { font-size: 19px; }
.compact #progress-marks .progress-mark { margin-left: 5px; }
.compact #chat { width: 305px; height: 210px; }
.compact #key-hints { bottom: 181px; }
.compact #top-actions .mini-icon { width: 19px; margin-right: 4px; }
.compact #top-actions .utility, .compact .credit-readout { padding-left: 5px; padding-right: 5px; }
.compact #identity .insignia { margin-right: 18px; }
.compact #identity .vital-label { width: 69px; }
.compact #identity .meter { width: 110px; margin-right: 8px; }
.small-window #identity { height: 238px; }
.small-window .small, .small-window .vital-label, .small-window .vital-value, .small-window .district-subtitle { font-size: 20px; }
.small-window #top-actions .utility, .small-window .credit-readout, .small-window #log, .small-window .nametag-copy { font-size: 20px; }
.small-window .compass-label, .small-window .compass-label.minor { font-size: 20px; }
.small-window .channel-title, .small-window .hint, .small-window #close, .small-window #modal-subtitle, .small-window .controls-copy, .small-window .feedback { font-size: 20px; }
.small-window #identity .vital-label { width: 82px; }
.small-window.compact #identity .meter { width: 97px; }

/* Sound and Video extend the field console; actions stay visible while rows scroll. */
#settings-panel { display: none; flex-grow: 1; flex-shrink: 1; min-height: 0; }
#modal.settings-modal { height: 850px; max-height: 92%; }
.settings-tabs { flex-direction: row; flex-shrink: 0; margin-bottom: 12px; border-bottom-width: 1px; border-bottom-color: #65706a; padding-bottom: 10px; }
.settings-tabs Button { width: 150px; margin-right: 10px; min-height: 46px; font-size: 21px; }
.settings-tabs .active-tab { color: #8be6df; border-bottom-width: 2px; border-bottom-color: #58d5d7; }
#settings-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
#sound-page, #video-page { padding: 0 12px 8px 0; }
.settings-heading { font-size: 23px; color: #daca9e; margin: 16px 0 10px; }
.settings-note { white-space: normal; color: #bcbcad; font-size: 18px; margin: 8px 0; flex-shrink: 0; }
.settings-row { flex-direction: row; align-items: center; min-height: 48px; flex-shrink: 0; }
.settings-field { min-height: 46px; margin: 3px 0; flex-shrink: 0; flex-grow: 1; font-size: 20px; align-items: center; }
.settings-field > .unity-base-field__label { min-width: 205px; width: 205px; color: #eee9dc; padding: 7px 0; margin-right: 12px; }
.settings-field > .unity-base-field__input { min-height: 38px; flex-grow: 1; }
.settings-field .unity-base-popup-field__input { background-color: #161e1e; color: #eee9dc; border-width: 1px; border-color: #7b8275; border-radius: 0; padding: 7px 12px; }
.settings-field:focus > .unity-base-field__input { border-color: #58d5d7; }
.settings-field .unity-base-popup-field__arrow { -unity-background-image-tint-color: #daca9e; }
.settings-field .unity-base-slider__tracker { height: 7px; background-color: #101a1b; border-width: 1px; border-color: #65706a; }
.settings-field .unity-base-slider__dragger { width: 17px; height: 26px; margin-top: -9px; background-color: #a48a62; border-width: 1px; border-color: #daca9e; border-radius: 0; }
.settings-field:focus .unity-base-slider__dragger, .settings-field .unity-base-slider__dragger:hover { background-color: #58d5d7; border-color: #8be6df; }
.settings-field .unity-base-slider__dragger-border { display: none; }
.setting-percent { width: 65px; margin-left: 14px; font-size: 20px; color: #eee9dc; -unity-text-align: middle-right; }
.settings-toggle .unity-toggle__input { background-color: transparent; }
.settings-toggle .unity-toggle__checkmark { width: 24px; height: 24px; background-color: #101a1b; border-width: 1px; border-color: #a48a62; border-radius: 0; -unity-background-image-tint-color: #8be6df; }
.settings-toggle:focus .unity-toggle__checkmark { border-color: #58d5d7; }
.settings-actions { flex-direction: row; justify-content: flex-end; flex-shrink: 0; margin-top: 8px; }
.settings-actions Button { min-height: 45px; margin-left: 10px; padding: 10px 20px; font-size: 19px; }
.primary-setting-action { color: #8be6df; }
#settings-status { margin-top: 12px; padding-top: 12px; border-top-width: 1px; border-top-color: #59615a; }
#video-confirmation { flex-shrink: 0; padding-top: 12px; border-top-width: 1px; border-top-color: #a48a62; }
#video-countdown { font-size: 22px; color: #eee9dc; }
#current-track { color: #8be6df; font-size: 21px; }
.unity-base-dropdown__container-outer { background-color: #161e1e; border-width: 1px; border-color: #a48a62; }
.unity-base-dropdown__item { color: #eee9dc; min-height: 33px; font-size: 20px; }
.unity-base-dropdown__item:hover, .unity-base-dropdown__item:checked { background-color: #294447; }
.small-window .settings-note, .small-window .settings-actions Button { font-size: 20px; }

/* Outer Berms combat (CombatHud.cs). Cyan marks aim/focus, vitality red marks harm; the center stays open. */
.crosshair { position: absolute; left: 50%; top: 50%; width: 36px; height: 36px; margin-left: -18px; margin-top: -18px; }
.crosshair-tick { position: absolute; background-color: rgba(238,233,220,0.85); border-width: 1px; border-color: rgba(12,20,19,0.55); }
.crosshair-tick.up { left: 17px; top: 2px; width: 2px; height: 9px; }
.crosshair-tick.down { left: 17px; bottom: 2px; width: 2px; height: 9px; }
.crosshair-tick.left { top: 17px; left: 2px; width: 9px; height: 2px; }
.crosshair-tick.right { top: 17px; right: 2px; width: 9px; height: 2px; }
.crosshair-dot { position: absolute; left: 16px; top: 16px; width: 4px; height: 4px; background-color: #58d5d7; }
.crosshair.aiming .crosshair-tick { background-color: #58d5d7; }
.crosshair.aiming .crosshair-tick.up { top: 6px; }
.crosshair.aiming .crosshair-tick.down { bottom: 6px; }
.crosshair.aiming .crosshair-tick.left { left: 6px; }
.crosshair.aiming .crosshair-tick.right { right: 6px; }
.hit-marker { position: absolute; left: 50%; top: 50%; width: 30px; height: 30px; margin-left: -15px; margin-top: -15px; }
.hit-marker-stroke { position: absolute; left: 13px; top: 1px; width: 3px; height: 28px; background-color: #eee9dc; }
.hit-marker-stroke.a { rotate: 45deg; }
.hit-marker-stroke.b { rotate: -45deg; }
.hit-marker.kill .hit-marker-stroke { background-color: #c65c4f; width: 4px; }
.damage-flash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0; border-width: 46px; border-color: rgba(150,38,30,0.55); }
/* Direction of incoming damage (2 Oct 2026, ranged droids): a zero-size pivot at screen centre, rotated toward the
   attacker; its bar sits on a ring around the crosshair. */
.damage-dir { position: absolute; left: 50%; top: 50%; width: 0; height: 0; opacity: 0; }
/* Outer Berms places on the compass (2 Oct 2026, BermsCompassPoint): amber sites (dim once cleared), cyan waystation, pale gate. */
.compass-poi { position: absolute; top: 3px; width: 10px; height: 10px; rotate: 45deg; background-color: #d39a4a; border-width: 1px; border-color: rgba(10,14,13,0.7); }
.compass-poi.waystation { background-color: #5fc7c9; }
.compass-poi.gate { background-color: #eee9dc; }
.compass-poi.cleared { opacity: 0.4; }
.compass-poi-label { position: absolute; top: 49px; left: 50%; width: 300px; margin-left: -150px; -unity-text-align: upper-center; font-size: 14px; color: #eee9dc; text-shadow: 1px 1px 0 rgba(0,0,0,0.85); }
.small-window .compass-poi-label { font-size: 20px; }
.damage-dir-arc { position: absolute; left: -58px; top: -178px; width: 116px; height: 9px; border-radius: 5px; background-color: rgba(198,92,79,0.9); border-width: 1px; border-color: rgba(238,233,220,0.55); }
.small-window .damage-dir-arc { top: -150px; width: 96px; left: -48px; }
.berms-objective { border-top-width: 1px; border-color: #65706a; margin-top: 8px; padding-top: 6px; }
.berms-heading { color: #a48a62; }
.berms-objective-text { white-space: normal; margin-top: 2px; }
.enemy-bar { position: absolute; width: 100px; height: 8px; background-color: rgba(12,20,19,0.8); border-width: 1px; border-color: #a48a62; }
.enemy-bar-fill { height: 100%; width: 100%; background-color: #c65c4f; border-top-width: 1px; border-top-color: #db7d6b; }
.enemy-bar-name { position: absolute; bottom: 9px; left: -30px; width: 160px; -unity-text-align: lower-center; font-size: 14px; color: #eee9dc; text-shadow: 1px 1px 0 rgba(0,0,0,0.8); }
.pistol-icon { background-image: url("Art/pistol.png"); }
.rifle-icon { background-image: url("Art/rifle.png"); }
.rifle-slot-icon { background-image: url("Art/rifle_slot.png"); }
.receiver-icon { background-image: url("Art/receiver.png"); }
.carrier-icon { background-image: url("Art/carrier.png"); }
.webbing-icon { background-image: url("Art/webbing.png"); }
.liner-icon { background-image: url("Art/liner.png"); }
.rivets-icon { background-image: url("Art/rivets.png"); }
.reaper-blade-icon { background-image: url("Art/reaper-blade.png"); }
.sentinel-optic-icon { background-image: url("Art/sentinel-optic.png"); }
.small-window .enemy-bar-name, .small-window .berms-objective-text { font-size: 20px; }

.checkpoint-guidance { position: absolute; width: 170px; padding: 5px; color: rgb(173, 233, 232); background-color: rgba(20, 29, 29, 0.88); border-bottom-width: 2px; border-bottom-color: rgb(77, 170, 174); font-size: 13px; -unity-text-align: middle-center; }

/* Gameplay v2 · salvage (CombatHud.cs). Rarity: Common warm white, Uncommon Ward cyan, Rare amber. */
.rarity-common { color: #eee9dc; }
.rarity-uncommon { color: #58d5d7; }
.rarity-rare { color: #e7a94a; }
.loot-toast { position: absolute; right: 20px; top: 200px; width: 446px; padding: 14px 26px 14px; }
.loot-toast-heading { color: #a48a62; border-bottom-width: 1px; border-bottom-color: #59615a; padding-bottom: 5px; margin-bottom: 6px; }
.loot-toast-line { font-size: 20px; white-space: normal; margin: 2px 0; }
.loot-toast-muted { color: #bcbcad; }
.loot-toast-warning { color: #db7d6b; font-size: 18px; }
.loot-toast-schematic { color: #8be6df; font-size: 18px; }
.compact .loot-toast { width: 380px; }
.small-window .loot-toast-line, .small-window .loot-toast-warning, .small-window .loot-toast-schematic { font-size: 20px; }
.search-progress { position: absolute; left: 50%; top: 58%; width: 300px; margin-left: -150px; padding: 12px 20px; }
.search-progress-label { font-size: 18px; color: #eee9dc; -unity-text-align: middle-center; margin-bottom: 7px; }
.search-progress-track { height: 10px; background-color: #101a1b; border-width: 1px; border-color: #65706a; }
.search-progress-fill { height: 100%; width: 0; background-color: #49cbd0; border-top-width: 1px; border-top-color: #86e6df; }
.small-window .search-progress-label { font-size: 20px; }

/* Gameplay v2 · Basic General (supplies and Buy parts | Sell salvage). SalvageSalePanel.cs, PartsShopPanel.cs. */
.shop-columns { flex-direction: row; align-items: flex-start; }
.shop-col { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; }
.shop-col-sell { margin-left: 22px; padding-left: 22px; border-left-width: 1px; border-left-color: #535f58; }
#shop-panel .balance { margin: 0 0 6px; font-size: 20px; }
.shop-section-heading { color: #a48a62; border-top-width: 1px; border-top-color: #7b8275; padding-top: 10px; margin-top: 10px; margin-bottom: 2px; }
.shop-first-heading { border-top-width: 0; padding-top: 0; margin-top: 0; }
.supply-row { min-height: 70px; padding: 4px 0; }
.supply-row .trade-art { width: 62px; height: 66px; margin-right: 14px; }
.supply-row .item-copy { font-size: 18px; }
.supply-row Button { width: 112px; }
.salvage-row, .part-row { min-height: 54px; padding: 3px 0; }
.salvage-art, .part-art { width: 50px; height: 50px; margin-right: 14px; }
.salvage-row .item-copy, .part-row .item-copy { font-size: 18px; }
.salvage-row Button, .part-row Button, .supply-row Button { min-height: 42px; padding: 9px 8px; margin-top: 2px; margin-bottom: 2px; }
.salvage-row Button, .part-row Button { width: 132px; }
.small-window .supply-row .item-copy, .small-window .salvage-row .item-copy, .small-window .part-row .item-copy { font-size: 20px; }

/* Gameplay v2 · wide modals (field fabricator, Basic General): everything fits at 1080p; the modal scroll view keeps
   keyboard focus in view at smaller sizes (UiNavigation.KeepFocusVisible). */
#modal.wide-modal { width: 1400px; max-width: 96%; }
#modal.wide-modal #modal-scroll { max-height: 690px; }

/* Gameplay v2 · field fabricator (FabricatorPanel.cs): schematics | selected schematic | pistol slots and stats.
   Cyan = ready/focus, bronze = structure, red = short. */
.fab-columns { flex-direction: row; align-items: stretch; }
.fab-col { flex-shrink: 0; }
.fab-col-list { width: 312px; padding-right: 18px; }
.fab-col-detail { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; padding: 0 20px; border-left-width: 1px; border-right-width: 1px; border-color: #535f58; }
.fab-col-pistol { width: 424px; padding-left: 20px; }
.fab-heading { color: #a48a62; margin-bottom: 6px; }
.fab-stats-heading { margin-top: 14px; }
.fab-group { color: #bcbcad; margin: 8px 0 3px; }
.fab-recipe { flex-direction: row; justify-content: space-between; align-items: center; min-height: 38px; padding: 7px 12px; margin: 2px 0; -unity-text-align: middle-left; }
.fab-recipe-name { flex-shrink: 1; font-size: 17px; white-space: normal; }
.fab-recipe-state { font-size: 14px; color: #bcbcad; margin-left: 8px; flex-shrink: 0; }
.fab-recipe.locked .fab-recipe-name { color: #8c958b; }
.fab-recipe.ready .fab-recipe-state { color: #58d5d7; }
.fab-recipe.fitted .fab-recipe-state { color: #daca9e; }
.fab-recipe.selected { border-left-width: 3px; border-left-color: #a48a62; background-image: url("Art/button-focus.png"); -unity-background-image-tint-color: #9fb5ad; }
.fab-recipe.selected:focus { -unity-background-image-tint-color: #ffffff; border-left-color: #58d5d7; }
.fab-title { font-size: 24px; color: #eee9dc; margin-bottom: 4px; white-space: normal; }
.fab-description { font-size: 17px; white-space: normal; margin-bottom: 10px; }
.fab-inputs { margin-bottom: 8px; }
.fab-input { flex-direction: row; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: #3f4a45; padding: 4px 2px; }
.fab-input-name { font-size: 18px; flex-shrink: 1; white-space: normal; }
.fab-input-count { font-size: 18px; margin-left: 12px; flex-shrink: 0; }
.have-ok { color: #8fcf8a; }
.have-short { color: #db7d6b; }
.fab-actions { flex-direction: row; flex-wrap: wrap; }
.fab-actions Button { margin: 4px 8px 4px 0; min-height: 44px; padding: 10px 16px; font-size: 17px; }
#fabricator-craft { color: #8be6df; }
#fabricator-craft:disabled { color: #8c958b; }
.fab-reason { font-size: 17px; white-space: normal; color: #bcbcad; margin-top: 6px; }
.fab-reason.blocked { color: #db7d6b; }
.fab-reason.fitted { color: #daca9e; }
#fab-slots { flex-direction: row; margin: 0 -4px; }
.fab-slot { flex-grow: 1; flex-basis: 0; min-width: 0; flex-direction: column; align-items: flex-start; justify-content: flex-start; min-height: 82px; padding: 14px 14px 12px 16px; margin: 3px 4px; }
.fab-slot-label { color: #a48a62; }
.fab-slot-mod { font-size: 16px; white-space: normal; -unity-text-align: upper-left; }
.fab-slot.empty .fab-slot-mod { color: #8c958b; }
.fab-slot.selected { border-left-width: 3px; border-left-color: #58d5d7; }
.fab-stat-row { flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: #3f4a45; min-height: 28px; }
.fab-stat-header { border-bottom-color: #65706a; min-height: 24px; }
.fab-stat-header Label { color: #a48a62; }
.fab-stat-name { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 17px; }
.fab-stat-cell { flex-shrink: 0; font-size: 17px; -unity-text-align: middle-right; padding-right: 6px; white-space: nowrap; }
.fab-stat-now { width: 84px; }
.fab-stat-preview { width: 96px; }
.fab-stat-delta { width: 78px; }
.fab-stat-header .fab-stat-cell, .fab-stat-header .fab-stat-name { font-size: 15px; }
.fab-stat-delta.better { color: #8fcf8a; }
.fab-stat-delta.worse { color: #db7d6b; }
.small-window .fab-recipe-name, .small-window .fab-stat-name, .small-window .fab-stat-cell, .small-window .fab-reason, .small-window .fab-description, .small-window .fab-slot-mod, .small-window .fab-input-name, .small-window .fab-input-count { font-size: 20px; }
.small-window .fab-col-list { width: 330px; }
.small-window .fab-col-pistol { width: 450px; }
.small-window .fab-stat-now { width: 92px; }
.small-window .fab-stat-preview { width: 104px; }
.small-window .fab-stat-delta { width: 84px; }
