#developer-time-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; }
#developer-time-panel { position: absolute; right: 30px; top: 30px; width: 440px; max-width: 94%; max-height: 88%; padding: 25px; }
.developer-time-heading { flex-direction: row; align-items: center; margin-bottom: 5px; }
.developer-time-heading .title { flex-grow: 1; font-size: 30px; }
#developer-time-close { min-height: 40px; padding: 8px 12px; margin-left: 10px; font-size: 16px; }
#developer-time-scroll { margin-top: 12px; }
#developer-time-readout { font-size: 30px; color: #eee9dc; margin-bottom: 8px; }
.developer-time-presets, .developer-time-speeds { flex-direction: row; }
.developer-time-presets Button, .developer-time-speeds Button { flex-grow: 1; flex-basis: 0; margin-right: 5px; padding: 10px 5px; min-height: 44px; }
.developer-time-speeds .selected { background-image: url("Art/button-focus.png"); }
#developer-time-slider, #developer-time-hour { margin-top: 14px; margin-bottom: 5px; }
#developer-time-panel .unity-base-field__label { min-width: 125px; color: #eee9dc; font-size: 18px; }
#developer-time-panel .unity-base-text-field__input { background-color: #161e1e; color: #eee9dc; padding: 6px; border-width: 1px; border-color: #a48a62; }
#developer-time-panel .unity-base-slider__dragger { background-color: #58d5d7; border-color: #eee9dc; width: 14px; height: 20px; margin-top: -7px; }
#developer-time-panel .unity-base-slider__tracker { background-color: #bcbcad; height: 4px; }
.developer-time-section { margin-top: 22px; margin-bottom: 5px; color: #eee9dc; font-size: 20px; }
#developer-time-status, #developer-time-reflections, .developer-time-help { white-space: normal; margin-top: 10px; }
#developer-time-reset { margin-top: 22px; }
#developer-time-panel.small-window { top: 12px; right: 12px; max-height: 94%; }
