ype":"VisualElement","visible":true,"enabled":false,"text":null,"bounds":[0,0,1920,1080],"fontSize":18.0,"classes":[]},{"name":"chat","type":"VisualElement","visible":true,"enabled":false,"text":null,"bounds":[20,872,430,188],"fontSize":18.0,"classes":["panel","movable-window"]},{"name":"chat-heading","type":"VisualElement","visible":true,"enabled":false,"text":null,"bounds":[42,887,386,25],"fontSize":18.0,"classes":["section-heading"]},{"name":"","type":"Label","visible":true,"enabled":false,"text":"LOCAL","bounds":[42,887,49,17],"fontSize":18.0,"classes":["unity-label","unity-text-element","channel-title"]},{"name":"","type":"Label","visible":true,"enabled":false,"text":"EVENT LOG","bounds":[353,888,75,15],"fontSize":16.0,"classes":["unity-label","unity-text-element","muted","small"]},{"name":"log-scroll","type":"ScrollView","visible":true,"enabled":false,"text":null,"bounds":[42,919,386,97],"fontSize":18.0,"classes":["unity-scroll-view","unity-scroll-view--vertical","unity-scroll-view--scroll"]},{"name":"unity-content-and-vertical-scroll-container","type":"VisualElement","visible":true,"enabled":false,"text":null,"bounds":[42,919,386,97],"fontSize":18.0,"classes":["unity-scroll-view__content-and-vertical-scroll-container"]},{"name":"unity-content-viewport","type":"VisualElement","visible":true,"enabled":false,"text":null,"bounds":[42,919,368,97],"fontSize":18.0,"classes":["unity-scroll-view__content-viewport","unity-scroll-view__content-viewport--vertical"]},{"name":"unity-content-container","type":"VisualElement","visible":true,"enabled":false,"text":null,"bounds":[42,529,368,487],"fontSize":18.0,"classes":["unity-scroll-view__content-container","unity-scroll-view__content-container--vertical"]},{"name":"log","type":"Label","visible":true,"enabled":false,"text":"Linn: Meet me on the hill.\nVex: Keep the passage clear and watch for the carts. Free Column rules are simple: everyone gets through, and everyone helps keep the gate standing.\nYou: Has this gate always been here?\nVex: The stone is older than the towers. Look closely and you can see three generations of repairs. We keep the old blocks because they still do the job.\nTorr: The city looks quiet from the hill. Down here, every cracked terminal has someone waiting on a spare part.\nYou: What is this slab used for?\nTorr: It used to match shifts with maintenance crews. Today we leave notes for each other. Ask around the hill before you trust a blank screen.\nLinn: Looking for someone? Try the shade. Sooner or later everyone comes up here, even the people who swear they are too busy.\nYou: Why does everyone meet here?\nLinn: You can see the gate, hear the market, and get out of the dust. No terminal needs to explain that. If we get separated, meet me on the hill.\nMira: Welcome to Basic General. Fresh seals on the flasks, checked packs in the medkits. I can buy that scrap coil if you need a few credits.\nYou: Show me your stock.\nMira: Bought Water Flask for 4 credits.\nMira: Sold Scrap Coil for 1 credit.","bounds":[42,529,368,487],"fontSize":18.0,"classes":["unity-label","unity-text-element"]},{"name":"unity-slider","type":"ScrollerSlider","visible":true,"enabled":false,"text":null,"bounds":[416,943,24,49],"fontSize":18.0,"classes":["unity-base-slider--vertical","unity-base-field","unity-base-slider","unity-scroller__slider","unity-slider","unity-base-field--no-label"]},{"name":"unity-drag-container","type":"VisualElement","visible":true,"enabled":false,"text":null,"bounds":[416,943,24,49],"fontSize":18.0,"classes":["unity-base-slider__drag-container"]},{"name":"unity-tracker","type":"VisualElement","visible":true,"enabled":false,"text":null,"bounds":[416,943,24,49],"fontSize":18.0,"classes":["unity-base-slider__tracker"]},{"name":"unity-dragger","type":"VisualElement","visible":true,"enabled":false,"text":null,"bounds":[419,982,18,10],"fontSize":18.0,"classes":["unity-base-slider__dragger"]},{"name":"chat-footer","type":"VisualElement","visible":true,"enabled":false,