 "lines": [
  {
   "id": "tutor_welcome",
   "speaker": "npc_brann",
   "kind": "welcome",
   "step": "",
   "verb": "",
   "key": "",
   "stage": -1,
   "trigger": "tutor.welcome",
   "text": "First one's by hand. I'll talk you through it.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_welcome.wav"
  },
  {
   "id": "tutor_s0_pistol",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s0.pistol",
   "verb": "",
   "key": "",
   "stage": 0,
   "trigger": "tutor.step:s0.pistol",
   "text": "Pistol first. Lay it on the black mat, flat.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s0_pistol.wav"
  },
  {
   "id": "tutor_s0_roll",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s0.roll",
   "verb": "",
   "key": "",
   "stage": 0,
   "trigger": "tutor.step:s0.roll",
   "text": "Your tool roll. Undo the strap, then roll it out.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s0_roll.wav"
  },
  {
   "id": "tutor_s0_salvage",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s0.salvage",
   "verb": "",
   "key": "",
   "stage": 0,
   "trigger": "tutor.step:s0.salvage",
   "text": "Servo, both alloy sheets and the vial. Into the tray.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s0_salvage.wav"
  },
  {
   "id": "tutor_s0_salvage_vial",
   "speaker": "npc_brann",
   "kind": "action",
   "step": "s0.salvage",
   "verb": "",
   "key": "vial",
   "stage": 0,
   "trigger": "tutor.action:s0.salvage:vial",
   "text": "Vial's round. Set it down gentle or it rolls.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s0_salvage_vial.wav"
  },
  {
   "id": "tutor_s0_salvage_r",
   "speaker": "npc_brann",
   "kind": "recovery",
   "step": "s0.salvage.r",
   "verb": "",
   "key": "",
   "stage": 0,
   "trigger": "tutor.recovery:s0.salvage.r",
   "text": "It rolled. Pick it up and try again, slower.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s0_salvage_r.wav"
  },
  {
   "id": "tutor_s0_card_before",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s0.card_before",
   "verb": "",
   "key": "",
   "stage": 0,
   "trigger": "tutor.step:s0.card_before",
   "text": "Pistol up. Three pulses at the card. See how it walks.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s0_card_before.wav"
  },
  {
   "id": "tutor_s0_shake_before",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s0.shake_before",
   "verb": "",
   "key": "",
   "stage": 0,
   "trigger": "tutor.step:s0.shake_before",
   "text": "Give it a shake if you like. Hear that rattle.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s0_shake_before.wav"
  },
  {
   "id": "tutor_s0_cell",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s0.cell",
   "verb": "",
   "key": "",
   "stage": 0,
   "trigger": "tutor.step:s0.cell",
   "text": "Cell out before anything else. Thumb the latch, then pull.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s0_cell.wav"
  },
  {
   "id": "tutor_seat_verb",
   "speaker": "npc_brann",
   "kind": "verb",
   "step": "",
   "verb": "seat",
   "key": "",
   "stage": -1,
   "trigger": "tutor.verb:seat",
   "text": "Take it and carry it over. Square it up and it drops in.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_seat_verb.wav"
  },
  {
   "id": "tutor_turn_verb",
   "speaker": "npc_brann",
   "kind": "verb",
   "step": "",
   "verb": "turn",
   "key": "",
   "stage": -1,
   "trigger": "tutor.verb:turn",
   "text": "Hold on it and circle the mouse slow. Feel it bite.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_turn_verb.wav"
  },
  {
   "id": "tutor_point_aim_verb",
   "speaker": "npc_brann",
   "kind": "verb",
   "step": "",
   "verb": "point_aim",
   "key": "",
   "stage": -1,
   "trigger": "tutor.verb:point_aim",
   "text": "Hold it on the card. It wanders. Fire when it's on.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_point_aim_verb.wav"
  },
  {
   "id": "tutor_point_verb",
   "speaker": "npc_brann",
   "kind": "verb",
   "step": "",
   "verb": "point",
   "key": "",
   "stage": -1,
   "trigger": "tutor.verb:point",
   "text": "Tool on the mark, then click. Just the mark.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_point_verb.wav"
  },
  {
   "id": "tutor_flick_verb",
   "speaker": "npc_brann",
   "kind": "verb",
   "step": "",
   "verb": "flick",
   "key": "",
   "stage": -1,
   "trigger": "tutor.verb:flick",
   "text": "Hold it and shake the mouse. Short and sharp.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_flick_verb.wav"
  },
  {
   "id": "tutor_path_verb",
   "speaker": "npc_brann",
   "kind": "verb",
   "step": "",
   "verb": "path",
   "key": "",
   "stage": -1,
   "trigger": "tutor.verb:path",
   "text": "Hold and follow the line. Steady pace, don't rush it.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_path_verb.wav"
  },
  {
   "id": "tutor_window_strike_verb",
   "speaker": "npc_brann",
   "kind": "verb",
   "step": "",
   "verb": "window_strike",
   "key": "",
   "stage": -1,
   "trigger": "tutor.verb:window_strike",
   "text": "Hold to lift, let go to strike. Higher hits harder.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_window_strike_verb.wav"
  },
  {
   "id": "tutor_window_hold_verb",
   "speaker": "npc_brann",
   "kind": "verb",
   "step": "",
   "verb": "window_hold",
   "key": "",
   "stage": -1,
   "trigger": "tutor.verb:window_hold",
   "text": "Hold it down and listen. Let go when it sounds right.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_window_hold_verb.wav"
  },
  {
   "id": "tutor_wipe_verb",
   "speaker": "npc_brann",
   "kind": "verb",
   "step": "",
   "verb": "wipe",
   "key": "",
   "stage": -1,
   "trigger": "tutor.verb:wipe",
   "text": "Hold and scrub over it. Keep going till it's bright.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_wipe_verb.wav"
  },
  {
   "id": "tutor_blocked_refused",
   "speaker": "npc_brann",
   "kind": "refused",
   "step": "",
   "verb": "blocked",
   "key": "",
   "stage": -1,
   "trigger": "tutor.refused:blocked",
   "text": "Something's still holding it. Free that first.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_blocked_refused.wav"
  },
  {
   "id": "tutor_not_yet_refused",
   "speaker": "npc_brann",
   "kind": "refused",
   "step": "",
   "verb": "not_yet",
   "key": "",
   "stage": -1,
   "trigger": "tutor.refused:not_yet",
   "text": "Not that one yet. Look for what's lit.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_not_yet_refused.wav"
  },
  {
   "id": "tutor_needs_tool_refused",
   "speaker": "npc_brann",
   "kind": "refused",
   "step": "",
   "verb": "needs_tool",
   "key": "",
   "stage": -1,
   "trigger": "tutor.refused:needs_tool",
   "text": "You'll want a tool for that.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_needs_tool_refused.wav"
  },
  {
   "id": "tutor_wrong_tool_refused",
   "speaker": "npc_brann",
   "kind": "refused",
   "step": "",
   "verb": "wrong_tool",
   "key": "",
   "stage": -1,
   "trigger": "tutor.refused:wrong_tool",
   "text": "Wrong tool for that. Put it back.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_wrong_tool_refused.wav"
  },
  {
   "id": "tutor_s1_clamp",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s1.clamp",
   "verb": "",
   "key": "",
   "stage": 1,
   "trigger": "tutor.step:s1.clamp",
   "text": "Frame in the vise. Snug, not tight, or you'll mark it.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_clamp.wav"
  },
  {
   "id": "tutor_s1_bind",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s1.bind",
   "verb": "",
   "key": "",
   "stage": 1,
   "trigger": "tutor.step:s1.bind",
   "text": "Cutters. Snip both wire twists on the old grip.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_bind.wav"
  },
  {
   "id": "tutor_s1_tape",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s1.tape",
   "verb": "",
   "key": "",
   "stage": 1,
   "trigger": "tutor.step:s1.tape",
   "text": "Peel the tape off. Find the loose end and follow it round.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_tape.wav"
  },
  {
   "id": "tutor_s1_screw_a",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s1.screw_a",
   "verb": "",
   "key": "",
   "stage": 1,
   "trigger": "tutor.step:s1.screw_a",
   "text": "Upper screw first. Slotted bit in the driver.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_screw_a.wav"
  },
  {
   "id": "tutor_s1_screw_a_dish",
   "speaker": "npc_brann",
   "kind": "action",
   "step": "s1.screw_a",
   "verb": "",
   "key": "dish",
   "stage": 1,
   "trigger": "tutor.action:s1.screw_a:dish",
   "text": "Screws go in the dish. Lose one and you're making another.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_screw_a_dish.wav"
  },
  {
   "id": "tutor_s1_screw_b",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s1.screw_b",
   "verb": "",
   "key": "",
   "stage": 1,
   "trigger": "tutor.step:s1.screw_b",
   "text": "Oil on the lower screw first. One drop. Let it soak.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_screw_b.wav"
  },
  {
   "id": "tutor_s1_screw_b_tap",
   "speaker": "npc_brann",
   "kind": "action",
   "step": "s1.screw_b",
   "verb": "",
   "key": "tap",
   "stage": 1,
   "trigger": "tutor.action:s1.screw_b:tap",
   "text": "Now tap the driver's head. Two taps. Wakes the thread up.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_screw_b_tap.wav"
  },
  {
   "id": "tutor_s1_screw_b_r",
   "speaker": "npc_brann",
   "kind": "recovery",
   "step": "s1.screw_b.r",
   "verb": "",
   "key": "",
   "stage": 1,
   "trigger": "tutor.recovery:s1.screw_b.r",
   "text": "Slot's gone round. Pliers on the head, back it out slow.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_screw_b_r.wav"
  },
  {
   "id": "tutor_s1_scales",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s1.scales",
   "verb": "",
   "key": "",
   "stage": 1,
   "trigger": "tutor.step:s1.scales",
   "text": "Screws are out. Lift both scales off, onto the mat.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_scales.wav"
  },
  {
   "id": "tutor_s1_lead",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s1.lead",
   "verb": "",
   "key": "",
   "stage": 1,
   "trigger": "tutor.step:s1.lead",
   "text": "Trigger lead. Pinch the tab, not the wire.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_lead.wav"
  },
  {
   "id": "tutor_s1_pin",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s1.pin",
   "verb": "",
   "key": "",
   "stage": 1,
   "trigger": "tutor.step:s1.pin",
   "text": "Punch on the pin, then the mallet. Three firm taps.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_pin.wav"
  },
  {
   "id": "tutor_s1_pin_pull",
   "speaker": "npc_brann",
   "kind": "action",
   "step": "s1.pin",
   "verb": "",
   "key": "pull",
   "stage": 1,
   "trigger": "tutor.action:s1.pin:pull",
   "text": "Pliers now. Pull it the rest of the way.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_pin_pull.wav"
  },
  {
   "id": "tutor_s1_pin_r",
   "speaker": "npc_brann",
   "kind": "recovery",
   "step": "s1.pin.r",
   "verb": "",
   "key": "",
   "stage": 1,
   "trigger": "tutor.recovery:s1.pin.r",
   "text": "Bent it. On the vise, tap it straight.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_pin_r.wav"
  },
  {
   "id": "tutor_s1_housing",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s1.housing",
   "verb": "",
   "key": "",
   "stage": 1,
   "trigger": "tutor.step:s1.housing",
   "text": "Slide the housing off. Thumb on that spring, it jumps.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_housing.wav"
  },
  {
   "id": "tutor_s1_inspect",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s1.inspect",
   "verb": "",
   "key": "",
   "stage": 1,
   "trigger": "tutor.step:s1.inspect",
   "text": "Turn the frame round in the vise. Look at the tang.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s1_inspect.wav"
  },
  {
   "id": "tutor_s2_swap",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s2.swap",
   "verb": "",
   "key": "",
   "stage": 2,
   "trigger": "tutor.step:s2.swap",
   "text": "Frame to the stand. Servo in the vise.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s2_swap.wav"
  },
  {
   "id": "tutor_s2_dust",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s2.dust",
   "verb": "",
   "key": "",
   "stage": 2,
   "trigger": "tutor.step:s2.dust",
   "text": "Brush it. The screws are under that muck.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s2_dust.wav"
  },
  {
   "id": "tutor_s2_screws",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s2.screws",
   "verb": "",
   "key": "",
   "stage": 2,
   "trigger": "tutor.step:s2.screws",
   "text": "Case screws. Cross bit this time.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s2_screws.wav"
  },
  {
   "id": "tutor_s2_stripped",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s2.stripped",
   "verb": "",
   "key": "",
   "stage": 2,
   "trigger": "tutor.step:s2.stripped",
   "text": "That one's chewed. Squeeze the pliers first, then turn.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s2_stripped.wav"
  },
  {
   "id": "tutor_s2_pry",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s2.pry",
   "verb": "",
   "key": "",
   "stage": 2,
   "trigger": "tutor.step:s2.pry",
   "text": "Pick in the seam. Three clips. Lean, don't stab.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s2_pry.wav"
  },
  {
   "id": "tutor_s2_leads",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s2.leads",
   "verb": "",
   "key": "",
   "stage": 2,
   "trigger": "tutor.step:s2.leads",
   "text": "Snip the leads at the board end. On the bands.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s2_leads.wav"
  },
  {
   "id": "tutor_s2_board",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s2.board",
   "verb": "",
   "key": "",
   "stage": 2,
   "trigger": "tutor.step:s2.board",
   "text": "Burnt board out. Keep its resistor, bin the rest.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s2_board.wav"
  },
  {
   "id": "tutor_s2_circlip",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s2.circlip",
   "verb": "",
   "key": "",
   "stage": 2,
   "trigger": "tutor.step:s2.circlip",
   "text": "Circlip next. Pliers. Keep hold or it flies.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s2_circlip.wav"
  },
  {
   "id": "tutor_s2_gears",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s2.gears",
   "verb": "",
   "key": "",
   "stage": 2,
   "trigger": "tutor.step:s2.gears",
   "text": "Gears off. Top one first.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s2_gears.wav"
  },
  {
   "id": "tutor_s2_trunnion",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s2.trunnion",
   "verb": "",
   "key": "",
   "stage": 2,
   "trigger": "tutor.step:s2.trunnion",
   "text": "Two small screws, then lift the gimbal. That's the prize.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s2_trunnion.wav"
  },
  {
   "id": "tutor_s2_winding",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s2.winding",
   "verb": "",
   "key": "",
   "stage": 2,
   "trigger": "tutor.step:s2.winding",
   "text": "Wind the copper onto the bobbin. Steady, it snaps.",
   "file": "Assets/AthenHill/Audio/ElevenLabs/Bench/Tutor/npc_brann-tutor_s2_winding.wav"
  },
  {
   "id": "tutor_s3_bath",
   "speaker": "npc_brann",
   "kind": "step",
   "step": "s3.bath",
   "verb": "",
   "key": "",
   "stage": 3,
